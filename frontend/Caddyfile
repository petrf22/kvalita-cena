# Globální blok (musí být první, bez adresy) — ACME_EMAIL dostává Let's Encrypt upozornění na
# blížící se expiraci/problém s obnovou certifikátu, jinak by si toho appka nevšimla (žádná
# analytika/monitoring, docs/soukromi.md). ACME_CA jde přepnout na Let's Encrypt staging
# (https://acme-staging-v02.api.letsencrypt.org/directory) při prvním ladění DNS/Caddyfile na
# produkci, ať se nepálí ostrý rate limit (docs/nasazeni.md) — výchozí hodnota je ostrá produkční
# autorita, takže bez proměnné se chování nemění.
{
	email {$ACME_EMAIL:kontakt@kvalitacena.cz}
	acme_ca {$ACME_CA:https://acme-v02.api.letsencrypt.org/directory}
}

# Bezpečnostní hlavičky společné webu i API. HSTS bez `includeSubDomains`/`preload` — obojí je
# závazek, který nejde rychle vzít zpět, a pod doménou můžou vzniknout i služby mimo tenhle
# server. Na holém http (lokální zkouška na *.localhost) prohlížeč HSTS ignoruje, neškodí.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

# SITE_ADDRESS = doména appky (kvalitacena.cz v produkci) — Caddy si pro ni sám obstará TLS
# (Let's Encrypt). Bez proměnné/DNS namířeného na server naslouchá jen na :80, ať jde image
# vyzkoušet i lokálně (docs/vydani.md plán, fáze "minimální produkční nasazení"). Dva site
# bloky teď musí mít výslovné složené závorky (Caddyfile syntax), jinak druhá adresa níže
# spadne na "unrecognized directive".
{$SITE_ADDRESS:http://localhost} {
	encode gzip
	import security_headers

	# Web se nikam nevkládá (clickjacking) a z rozhraní prohlížeče potřebuje jen kameru (sken
	# kódu, focení) a polohu (obchody v okolí) — obojí jen sám pro sebe.
	#
	# CSP zatím jen Report-Only: porušení se vypíše do konzole prohlížeče, ale nic se neblokuje.
	# Ostrou hlavičku zapnout až po projití webu s otevřenou konzolí (docs/nasazeni.md, „Zbývá")
	# — špatně odhadnutý zdroj by jinak rozbil web všem. `style-src 'unsafe-inline'` je nutné
	# (Angular i ng-zorro vkládají <style> za běhu), obrázky jdou i z cizích domén (dlaždice mapy,
	# fotky z Open Food Facts), `blob:` kvůli náhledům fotek a Web Workeru s proof-of-work.
	header {
		X-Frame-Options DENY
		Permissions-Policy "camera=(self), geolocation=(self), microphone=(), payment=(), usb=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	# Stejný origin jako web (viz komentář v Dockerfile) — /api a /graphql jdou na backend
	# kontejner podle jména služby z compose.prod.yaml, ne přes veřejnou adresu.
	#
	# header_up X-Forwarded-For PŘEPÍŠE hlavičku hodnotou skutečné spojovací IP, ne k ní jen
	# připojí (výchozí chování Caddy) — bez tohohle by si klient mohl poslat vlastní
	# "X-Forwarded-For: 1.2.3.4" a obejít tak rate limity počítané podle IP (ClientIpResolver
	# v backendu je druhá, nezávislá pojistka proti stejné díře).
	handle /api/* {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	handle /graphql {
		reverse_proxy backend:8080 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# Angular SPA — neznámá cesta padá na index.html, o zbytek routingu se postará klient.
	#
	# Cache: soubory s hashem v názvu (`main-ABC123XY.js`, `outputHashing: all` v angular.json) se
	# nikdy nemění, takže smí zůstat v cache napořád. Všechno ostatní — hlavně index.html, i ten
	# vrácený jako fallback pro cestu `/product/…` — se musí pokaždé ověřit u serveru: prohlížeč
	# se starým shellem by po nasazení žádal hashované soubory, které už neexistují, a web by
	# zůstal bílý do ručního obnovení. `no-cache` není „neukládat", jen „před použitím se zeptat"
	# (ETag → 304), takže to nic nestojí. Matchery se musí vylučovat: `header` není koncová
	# direktiva a při dvou shodách by vyhrála ta provedená později.
	handle {
		root * /srv
		@hashed path_regexp -[A-Za-z0-9_]{8}\.(js|css|woff2?)$
		@unhashed not path_regexp -[A-Za-z0-9_]{8}\.(js|css|woff2?)$
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		header @unhashed Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}
}

# API_ADDRESS = api.kvalitacena.cz v produkci (mobile/app/build.gradle.kts, release BASE_URL) —
# vlastní site blok, jinak by Caddy pro tenhle hostname vůbec nezískal TLS certifikát a
# release APK by neměl kam mluvit (docs/nasazeni.md, DNS záznamy). Web na tuhle adresu nemíří,
# proxuje se sem rovnou celý provoz, žádný SPA fallback.
{$API_ADDRESS:http://api.localhost} {
	encode gzip
	import security_headers

	reverse_proxy backend:8080 {
		header_up X-Forwarded-For {remote_host}
	}
}

# WWW_ADDRESS = www.kvalitacena.cz, nepovinné — appka na `www.` nikdy nemířila, tenhle blok
# jen zachytí případné odkazy/DNS omylem s "www" a přesměruje na kanonickou adresu bez ní. Bez
# nastavené proměnné (a bez DNS na "www.localhost") se blok nikdy neaktivuje, chování appky se
# nemění. Vyžaduje vlastní A/AAAA záznam na `www.kvalitacena.cz` (docs/nasazeni.md), jinak Caddy
# nemá pro co získat certifikát.
{$WWW_ADDRESS:http://www.localhost} {
	redir https://kvalitacena.cz{uri} permanent
}
