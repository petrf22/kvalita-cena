"""
MVP — hledání zboží s filtry a řazením, ceny po obchodech, hodnocení kvality (hvězdičky 1–5
s volitelným textem recenze), denní historie ceny pro graf, dohledání nejbližších provozoven
a zápis ceny. Skupiny důvěry, notifikace a dodavatelé přijdou v dalším rozvoji.
"""
scalar Long
scalar BigDecimal
scalar DateTime
scalar Date

enum ProductSort {
  "Výchozí — nejvíc potvrzené zboží nahoře (součet agg.price_current.n_obs)."
  REPORT_COUNT
  PRICE_ASC
  "5 = nejlepší, tedy sestupně."
  QUALITY
  LAST_REPORTED
  NAME
}

type Query {
  """
  Fulltextové hledání podle názvu (core.product, idx_product_name_norm_fts) s volitelným
  filtrem na obchod, město nebo kategorii a řazením. storeId/city omezují i agregáty
  v ProductSearchItem — s filtrem na město ukazuje seznam cenu a počet hlášení jen za dané
  město, ne celostátně.

  Hledá se ZÁROVEŇ v názvu zboží a v číselníku kategorií: když napsané slovo sedne na
  kategorii, vrátí se i celý její podstrom, i když to slovo v názvu zboží není ("bio 3,5 % tuku"
  v kategorii "Mléko" se najde na "mléko"). Výsledek je jeden sloučený seznam se stávajícím
  řazením — ProductSearchItem záměrně neříká, kterou cestou se položka našla. Kategorie se
  matchuje pod tím názvem, který klient v daném jazyce uvidí (core.category_i18n, fallback
  core.category.name), plus jazykově neutrální slug. Diakritika je na obou stranách sjednocená
  přes core.norm_text, takže "mleko" najde "Mléko".

  categoryId navíc explicitně OMEZUJE výsledek na podstrom vybrané kategorie (AND nad textovou
  shodou) — neexistující id vrací chybu CATEGORY_NOT_FOUND, ne prázdný seznam, protože jde
  o fixní číselník.

  Dotaz tvořený jen číslicemi délky 8–14 se navíc zkusí i jako čárový kód (core.product_code,
  code_type GTIN — nikdy STORE_INTERNAL, ten není globální identifikátor) vedle fulltextu podle
  názvu (ProductSearchService.codeQuery) — appka tak umí najít zboží podle EANu, ne jen podle
  jména.

  country omezuje na provozovny v jedné zemi/měně (docs/lokalizace.md) — bez toho by
  ProductSort.PRICE_ASC řadilo CZK vedle PLN v jednom sloupci a "nejlevnější obchod" by
  porovnával nesrovnatelné částky. Bez zadání se použije země přihlášeného uživatele, jinak
  app.i18n.default-country — NIKDY neomezené celosvětové hledání.
  """
  searchProducts(
    query: String!
    storeId: ID
    city: String
    "Filtr kategorie VČETNĚ podstromu — 'Mléčné výrobky' vrátí i Máslo a Sýry."
    categoryId: ID
    country: String
    sort: ProductSort = REPORT_COUNT
    first: Int = 20
    offset: Int = 0
  ): ProductSearchResult!

  "Číselník pro filtry hledání — jen obchody a města, kde nějaká cena skutečně je. country viz searchProducts."
  searchFacets(query: String, country: String): SearchFacets!

  """
  Našeptávač obchodů podle názvu/města (core.norm_text, pg_trgm) — doplněk k nearbyStores pro
  zápis ceny bez sdílení polohy nebo zpětně z domova (docs/datovy-model.md, "Identita
  provozovny"). Na rozdíl od nearbyStores najde i obchody bez souřadnic.
  """
  searchStores(query: String, city: String, first: Int = 20, offset: Int = 0): StoreSearchResult!

  """
  Číselník řetězců pro našeptávání při zakládání obchodu. Fixní kurátorský číselník naplněný
  migrací — createChain mutace záměrně neexistuje, stejně jako u kategorií (docs/rozvoj.md).
  Bez country server dosadí zemi vieweru (CountryResolver, docs/lokalizace.md).
  """
  chains(query: String, country: String, first: Int = 20): [RetailChain!]!

  """
  Detail jedné provozovny (stránka obchodu — adresa, mapa, fotky). Stejná viditelnost pod
  prahem důvěry jako product(id): ACTIVE vidí každý, vlastní PENDING (docs/reputace.md) jen
  autor. Null, když provozovna neexistuje nebo není vidět.
  """
  store(id: ID!): Store

  """
  Podobné zboží podle názvu (pg_trgm) — druhové položky (Product.isGeneric) i zboží s kódem.
  Slouží k nabídnutí existující druhové položky při bezkódovém zápisu i jako povinná kontrola
  duplicit před založením nového zboží (docs/reputace.md, "Zboží bez čárového kódu").
  """
  productSuggestions(name: String!, storeId: ID, first: Int = 10): [Product!]!

  """
  Plochý seznam kategorií pro zakládání zboží — hierarchii nese Category.path (řetězec
  slugů), pořadí sourozenců v jedné větvi Category.sortOrder. Klient si strom staví sám.
  """
  categories: [Category!]!

  """
  Souřadnice k zadané adrese přes OpenStreetMap Nominatim. Dotaz jde VŽDY ze serveru, nikdy
  z klienta (docs/soukromi.md — jinak by šla přímo IP uživatele) a odpověď se necachuje do
  core.*/osm.* — ukládá se jen zvolený bod jako core.store.lat/lon + osmRef s geoSource=OSM.
  UI MUSÍ zobrazit attribution. Výpadek Nominatimu vrací prázdný seznam kandidátů, nikdy chybu
  — založení obchodu bez souřadnic musí projít i tak.

  country bez zadání NEZNAMENÁ "celý svět" — server dosadí zemi přihlášeného uživatele, jinak
  app.i18n.default-country (docs/lokalizace.md), nikdy neomezené celosvětové hledání.
  """
  geocodeAddress(street: String, city: String!, postalCode: String, country: String): GeocodeResult!

  """
  Opačný směr než geocodeAddress — souřadnice na adresu, pro tlačítko "Použít mou polohu" při
  editaci obchodu. Stejná pravidla soukromí platí ještě přísněji: parametrem je tady rovnou
  poloha UŽIVATELE, ne adresa obchodu, takže dotaz jde výhradně ze serveru
  (docs/soukromi.md) a souřadnice se nikam nezapisují. Server souřadnice zaokrouhlí na 4
  desetinná místa (~11 m), než je pošle Nominatimu. Výpadek Nominatimu vrací prázdná pole,
  nikdy chybu.
  """
  reverseGeocode(lat: Float!, lon: Float!): ReverseGeocodeResult!

  """
  Údaje o firmě z veřejného rejstříku podle IČO/NIP — předvyplnění formuláře obchodu (zatím jen
  ARES pro CZ, docs/lokalizace.md). Není ODbL data (je to veřejný rejstřík, ne OSM/OFF), takže
  se nemusí držet stranou core.*. Vrací null, když IČO/NIP neexistuje, je registr nedostupný,
  nebo appka pro danou zemi žádný registr nezná (klient pak schová tlačítko "Načíst z registru").
  """
  companyByIco(ico: String!, country: String): CompanyInfo

  "Číselník zemí, které appka zná — viz CountryInfo."
  countries: [CountryInfo!]!

  product(id: ID!): Product

  """
  Dohledání produktu podle naskenovaného čárového kódu (EAN). Backend kód normalizuje na
  GTIN-14 (docs/datovy-model.md) — mobil posílá kód přesně tak, jak ho přečetl skener.
  """
  productByCode(code: String!): Product

  """
  Jediný vstupní bod pro sken: nejdřív vlastní katalog, potom lokální snapshot / API Open
  Food Facts. NOT_FOUND a OFF_UNAVAILABLE jsou běžné stavy, ne GraphQL chyby.
  """
  productLookupByCode(code: String!): ProductLookupResult!

  """
  Recenze pod zbožím — jen s textem a neskryté, nejnovější první (docs/reputace.md, T1: texty
  vidí jen přihlášený). Nepřihlášený dostane loginRequired=true a prázdné items, ale skutečný
  totalCount, ať klient umí zobrazit "N recenzí, přihlas se pro zobrazení" místo prázdného stavu.
  """
  productReviews(productId: ID!, first: Int = 20, offset: Int = 0): ProductReviewResult!

  """
  Provozovny v okolí zadaného bodu. Souřadnice se používají JEN jako parametry dotazu
  a nikam se neukládají — viz docs/soukromi.md. Server je zaokrouhlí na 3 desetinná místa
  (~110 m) — při rádiusu 3–25 km pod rozlišovací schopnost výsledku.
  """
  nearbyStores(lat: Float!, lon: Float!, radiusKm: Float = 3): [Store!]!

  """
  Denní řada z agg.price_daily. Graf NIKDY nečte core.price_observation
  (docs/datovy-model.md). Bez storeId je to medián mediánů přes provozovny
  (docs/reputace.md), se storeId jedna provozovna.

  currency omezí (nebo přepíše) měnu grafu — bez zadání se národní graf ukáže v měně
  s nejvíc záznamy za dané období (docs/lokalizace.md).
  """
  priceHistory(productId: ID!, priceKind: PriceKind = REGULAR, storeId: ID, days: Int = 90, currency: String): PriceHistory!

  "Veřejná identita přihlášeného uživatele — bez e-mailu a bez DB id (docs/soukromi.md)."
  me: Viewer

  """
  Zobrazovací měny a stav kurzovního lístku ČNB (docs/lokalizace.md, "Kurzovní lístek a
  zobrazovací měna"). USD je jen referenční — cenu v ní zapsat nejde (SubmitObservationsInput
  ji nepřijímá), je to výhradně přepočet pro zobrazení napříč zeměmi.
  """
  fxInfo: FxInfo!

  """
  Vlastní založené zboží (core.product.created_by_user_id), nejnovější první — se stavem
  zveřejnění (docs/datovy-model.md, "Uživatelská vrstva nad globálními daty"; práh v
  docs/reputace.md). Vyžaduje přihlášení.
  """
  myProducts(first: Int = 20, offset: Int = 0): MyProductResult!

  "Vlastní založené provozovny, stejný princip jako myProducts. Vyžaduje přihlášení."
  myStores(first: Int = 20, offset: Int = 0): MyStoreResult!

  """
  Vlastní zapsané ceny (core.price_observation.submitter_id), nejnovější první — stav
  zveřejnění se dědí od blokujícího katalogového záznamu (zboží/obchod), sama cena žádný
  práh nemá. Zmizí odsud po pseudonymizaci vazby na účet po 180 dnech (docs/soukromi.md).
  Vyžaduje přihlášení.
  """
  myObservations(first: Int = 20, offset: Int = 0): MyObservationResult!

  """
  Vlastní úpravy cizích záznamů (core.product_user_edit/core.store_user_edit) — vidí je jen
  autor, dokud neproběhne (zatím nenapsaný) konsolidační job. Vyžaduje přihlášení.
  """
  myEdits(first: Int = 20, offset: Int = 0): MyEditResult!

  """
  Vlastní recenze s textem, nejnovější první — na rozdíl od productReviews vrací i vlastní
  recenze skryté moderací (autor tak vidí, že a proč zmizela z produktu). Vyžaduje přihlášení.
  """
  myReviews(first: Int = 20, offset: Int = 0): MyReviewResult!

  """
  Fronta nahlášených záznamů čekajících na přezkum (docs/reputace.md, "Moderace") — bez
  recordType všechny tři typy najednou. Jen moderátor (T4), jinak MODERATION_REQUIRES_ROLE.
  """
  flaggedRecords(recordType: RecordType, first: Int = 20, offset: Int = 0): FlaggedRecordResult!

  """
  Ceny k moderátorskému přezkumu — cenu nejde nahlásit komunitně (viz setObservationRejected),
  takže moderátor k ní přistupuje přímo přes autora/zboží/obchod. Bez filtru nejnovější napříč
  celou appkou. Jen moderátor.
  """
  moderationObservations(authorPublicUid: ID, productId: ID, storeId: ID,
    first: Int = 20, offset: Int = 0): ModerationObservationResult!

  """
  Fronta zpětné vazby od uživatelů appky (core.feedback, docs/nasazeni.md "Než pozvat první
  lidi") — handled null vrací obojí, jinak filtruje podle vyřízeno/nevyřízeno. quarantined
  (výchozí false) odděluje běžnou frontu od záložky "Podezřelé" (FeedbackSpamDetector) — obě
  fronty se nemíchají, ať karanténa nezavalí moderátora spolu se skutečnými hlášeními. Jen
  moderátor.
  """
  feedbackItems(handled: Boolean, quarantined: Boolean = false, first: Int = 20, offset: Int = 0): FeedbackItemResult!

  """
  Proof-of-work výzva pro formulář zpětné vazby (docs/nasazeni.md, obrana proti spamu) — bez
  přihlášení, stejně jako submitFeedback samotné. Klient spočítá nonce tak, aby
  SHA-256(salt + ":" + nonce) mělo `difficulty` vedoucích nulových bitů, a pošle ho zpět ve
  FeedbackInput spolu s token beze změny.
  """
  feedbackChallenge: FeedbackChallenge!
}

type Mutation {
  """
  Zápis jedné nebo víc cen TÉHOŽ zboží v TÉMŽE obchodě — u regálu je běžně cena běžná
  i klubová, případně množstevní sleva, a všechny se zapisují jedním odesláním. Jedna
  transakce: kolize jediného druhu ceny s dnešním zápisem shodí celou dávku
  (uq_price_observation_submitter_kind_per_day, docs/reputace.md). Funguje i anonymně
  (nižší váha, viz docs/reputace.md). Pořadí výsledku odpovídá pořadí `prices` na vstupu.
  """
  submitObservations(input: SubmitObservationsInput!): [PriceObservation!]!

  """
  Hodnocení kvality hvězdičkami: 1 nejhorší … 5 nejlepší. Jeden záznam na uživatele a produkt
  — opakované volání předchozí hodnocení přepíše. Text recenze (pokud existuje) zůstává
  netknutý. Vyžaduje přihlášení.
  """
  rateProduct(productId: ID!, stars: Int!): ProductQuality!

  """
  Zapsání nebo úprava textu recenze k VLASTNÍMU hodnocení — hvězdičky musí existovat dřív
  (REVIEW_REQUIRES_RATING), text sám bez hvězdiček nejde založit. Max 1000 znaků
  (REVIEW_TEXT_TOO_LONG), prázdný/jen bílé znaky je REVIEW_TEXT_EMPTY (na smazání textu slouží
  deleteProductReviewText, ne prázdný řetězec). Vyžaduje přihlášení.
  """
  saveProductReviewText(productId: ID!, text: String!): MyProductReview!

  "Smazání textu recenze — hvězdičky zůstávají beze změny. Vyžaduje přihlášení."
  deleteProductReviewText(productId: ID!): MyProductReview!

  """
  Založení provozovny — pro zápis ceny bez sdílení polohy nebo zpětně z domova. Vyžaduje
  přihlášení (docs/reputace.md, T1) a rovnou zakládá ACTIVE záznam; klient si před voláním
  MUSÍ ověřit searchStores(name, city) a nabídnout uživateli případné shody (uq_store_identity
  je až poslední pojistka, ne jediná obrana proti duplicitám).
  """
  createStore(input: CreateStoreInput!): Store!

  """
  Založení zboží — s naskenovaným kódem i bez něj (bezkódová druhová položka, docs/reputace.md,
  "Zboží bez čárového kódu"). Vyžaduje přihlášení. Bez kódu vzniká jako status DRAFT a
  isGeneric=true; klient by měl nejdřív zkusit productSuggestions(name), ať nezaloží duplikát
  existující druhové položky.
  """
  createProduct(input: CreateProductInput!): Product!
  "Založí identitu produktu nad potvrzeným OFF kandidátem; odchylky uloží jako product_user_edit."
  createProductFromOff(input: CreateProductFromOffInput!): Product!

  """
  Úprava existujícího zboží jako patch nad core.product_user_edit — globální řádek se nemění,
  úpravu vidí jen autor (docs/datovy-model.md, "Uživatelská vrstva nad globálními daty").
  Vyžaduje přihlášení. Pole s hodnotou null v inputu zůstává nezměněné.
  """
  updateProduct(id: ID!, input: UpdateProductInput!): Product!

  """
  Úprava existující provozovny jako patch nad core.store_user_edit — stejný princip jako
  updateProduct. Vyžaduje přihlášení.
  """
  updateStore(id: ID!, input: UpdateStoreInput!): Store!

  """
  Nahlášení zboží/obchodu jako podezřelého nebo nesmyslného — hlasuje se o FAKTU, nikdy o
  ČLOVĚKU (docs/reputace.md, "Nesouhlas se vyjadřuje k faktu, ne k člověku"). Po dosažení
  app.moderation.flags-to-hide různých nahlášení se záznam skryje a čeká na přezkum. Vyžaduje
  přihlášení; opakované nahlášení stejným člověkem nic nemění.
  """
  flagRecord(recordType: RecordType!, recordId: ID!, reason: String): FlagResult!

  """
  Popisek, pořadí a druh fotky (nejnižší sortOrder = hlavní fotka záznamu). Jen autor fotky,
  jinak UnauthorizedException.
  """
  updatePhoto(id: ID!, caption: String, sortOrder: Int, kind: PhotoKind): Photo!

  "Smazání vlastní fotky (core.media i soubor v MediaStorage). Jen autor."
  deletePhoto(id: ID!): Boolean!

  """
  Uloží preferovaný jazyk a zemi přihlášeného uživatele — používá se VÝHRADNĚ pro asynchronní
  výstup (OTP e-mail, později notifikace). Synchronní odpovědi tohoto API se vždy řídí hlavičkou
  Accept-Language, ne touhle hodnotou (docs/lokalizace.md). Volba jazyka je autoritativně na
  klientovi, tahle mutace ji jen posílá na server. Vyžaduje přihlášení.
  """
  setLocale(locale: String!, country: String): Viewer!

  """
  Úprava profilu (jméno, příjmení, přezdívka, telefon, kontaktní e-mail, viditelnost) —
  docs/soukromi.md, "Profil uživatele a viditelnost". Vyžaduje přihlášení. Avatar se nahrává
  přes REST POST /api/media/user/avatar (multipart, stejný důvod jako u ostatních fotek),
  tahle mutace ho jen umí smazat (deleteAvatar).
  """
  updateProfile(input: UpdateProfileInput!): Viewer!

  "Smazání avatara profilu. Vyžaduje přihlášení."
  deleteAvatar: Viewer!

  """
  Zpětná vazba od uživatele appky (core.feedback) — funguje i BEZ přihlášení, na rozdíl od
  flagRecord/rateProduct. Klient/verze appky/IP se čtou ze serveru (hlaviček), ne z inputu.
  """
  submitFeedback(input: FeedbackInput!): FeedbackResult!

  """
  Vyřízení/vrácení jednoho hlášení zpětné vazby do fronty (core.feedback). Jen moderátor.
  """
  setFeedbackHandled(id: ID!, handled: Boolean!, note: String): Boolean!

  """
  Vrácení podezřelé zprávy z karantény zpět do běžné fronty, nebo naopak (docs/nasazeni.md,
  obrana proti spamu, FeedbackSpamDetector) — cesta zpět pro falešný poplach, stejný princip
  jako resolveFlags DISMISSED. Jen moderátor.
  """
  setFeedbackQuarantined(id: ID!, quarantined: Boolean!): Boolean!

  """
  Vyřízení všech dosud nevyřízených nahlášení jednoho záznamu (docs/reputace.md, "Moderace").
  DISMISSED vrátí hidden_at cíle na NULL (jediná cesta zpět, jinak by chybné nahlášení bylo
  trvalé), UPHELD ho nastaví/ponechá. Jen moderátor (T4).
  """
  resolveFlags(recordType: RecordType!, recordId: ID!, resolution: FlagResolution!): Boolean!

  """
  Zamítnutí/obnovení jednotlivé ceny moderátorem — nesouhlas s cenou nejde nahlásit komunitně
  (docs/reputace.md, cena se opravuje novým zápisem, ne flagem), takže tohle je jediná cesta,
  jak vadnou cenu dostat ven z agregátu. Vždy zařadí dotčenou buňku do přepočtu
  (agg.recompute_queue), jinak by REJECTED cena zůstala viditelná v grafu ještě několik dní.
  Jen moderátor.
  """
  setObservationRejected(id: ID!, rejected: Boolean!, reason: String): PriceObservation!

  """
  Pozastavení/obnovení účtu (docs/podminky-uziti.md, "Ukončení a vyloučení") — pozastavený
  účet se přestane autentizovat nejpozději do 60 s a nedostane nový přihlašovací kód. Jen
  moderátor.
  """
  setUserSuspended(publicUid: ID!, suspended: Boolean!, reason: String): Boolean!
}

enum RecordType {
  PRODUCT
  STORE
  "Nahlašovaný typ pro flagRecord — core.media samo nese jen PRODUCT/STORE (čí je fotka)."
  PHOTO
  "Nahlašovaný typ pro TEXT recenze (core.product_review.text), ne pro hodnocení samotné ani autora."
  REVIEW
}

"""
Druh fotky (core.media.photo_kind) — nezávislá osa od RecordType (ten říká čí je fotka, tohle
co na ní je). ITEM, ne PRODUCT — RecordType.PRODUCT už znamená totéž na jiné ose. Posílá se při
uploadu jako parametr kind REST endpointu POST /api/media/{recordType}/{recordId}.
"""
enum PhotoKind {
  "Fotka samotného zboží/obalu."
  ITEM
  "Fotka etikety — zamýšlený budoucí vstup pro čtení složení/textu z etikety (docs/ai.md)."
  LABEL
  "Cokoli jiného, včetně fotek provozoven a avatarů (druh nerozlišují, zůstávají na OTHER)."
  OTHER
}

"""
Fotka zboží nebo provozovny (core.media) — nahrává se přes REST POST /api/media/{recordType}/
{recordId}, protože multipart upload GraphQL v tomhle projektu nepodporuje (viz backend
MediaController). url/thumbnailUrl vedou na stejný REST endpoint (GET).
"""
type Photo {
  id: ID!
  url: String!
  thumbnailUrl: String!
  width: Int!
  height: Int!
  caption: String
  "Nahrál ji přihlášený uživatel — smí ji smazat a upravit popisek."
  mine: Boolean!
  "Skrytá po nahlášení (RecordType.PHOTO); vidí ji dál už jen autor (docs/reputace.md)."
  hidden: Boolean!
  "Povinný text licence, klient ho MUSÍ zobrazit u galerie."
  attribution: String!
  kind: PhotoKind!
}

input UpdateProductInput {
  name: String
  brandName: String
  "True smaže značku (vrátí zboží na 'bez značky') — jinak se posílá brandName."
  clearBrand: Boolean = false
  categoryId: ID
  unitBase: UnitBase
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  piecesInPack: Int
  clearPiecesInPack: Boolean = false
  isVariableWeight: Boolean
}

input UpdateStoreInput {
  name: String
  chainId: ID
  clearChain: Boolean = false
  street: String
  clearStreet: Boolean = false
  city: String
  postalCode: String
  clearPostalCode: Boolean = false
  country: String
  "8 číslic, ověří se kontrolním součtem — viz docs/soukromi.md."
  ico: String
  clearIco: Boolean = false
  lat: Float
  lon: Float
  geoSource: GeoSource
  osmRef: String
  "Odkaz na stránku provozovny (u řetězce) — jako street/city jde přes core.store_user_edit."
  url: String
  clearUrl: Boolean = false
}

type FlagResult {
  "Kolik různých lidí záznam zatím nahlásilo."
  flagCount: Int!
  "True, pokud nahlášení právě teď (nebo už dřív) záznam skrylo."
  hidden: Boolean!
}

"Výsledek moderátorského přezkumu nahlášeného záznamu (docs/reputace.md, 'Moderace')."
enum FlagResolution {
  "Nahlášení bylo neopodstatněné — hidden_at cíle se vrátí na NULL."
  DISMISSED
  "Nahlášení bylo oprávněné — cíl zůstává (nebo se nově nastaví) skrytý."
  UPHELD
}

"""
Jeden nahlášený záznam ve frontě k přezkumu — přesně jedno z product/store/photo je vyplněné,
podle recordType (stejný polymorfní tvar jako MyEditItem). Vrací se i skrytý cíl (moderátor
vidí to, co ostatním hidden_at schovává).
"""
type FlaggedRecordItem {
  recordType: RecordType!
  recordId: ID!
  "Kolik různých lidí záznam nahlásilo — může být i pod prahem, pokud sem moderátor přišel jinou cestou."
  flagCount: Int!
  firstFlaggedAt: DateTime!
  lastFlaggedAt: DateTime!
  "Texty od nahlašovatelů (core.record_flag.reason), bez vazby na to, kdo je napsal (docs/soukromi.md)."
  reasons: [String!]!
  hidden: Boolean!
  "Kdo záznam založil/nahrál — null u anonymního příspěvku nebo po pseudonymizaci (180 dní)."
  authorPublicUid: ID
  "Vykreslená podoba ('Modrý čáp #4271'), ne kanonický klíč — jen pro čtení, k identifikaci použij authorPublicUid."
  authorHandle: String
  "Vyplněno jen pro recordType PRODUCT, jinak null."
  product: Product
  "Vyplněno jen pro recordType STORE, jinak null."
  store: Store
  "Vyplněno jen pro recordType PHOTO, jinak null."
  photo: Photo
  "Vyplněno jen pro recordType REVIEW, jinak null."
  review: FlaggedReview
}

"Nahlášená recenze v moderátorské frontě — na rozdíl od veřejného ProductReview nese i product (kontext, ke kterému text patří), ne authorName (ten nese FlaggedRecordItem.authorHandle výš)."
type FlaggedReview {
  id: ID!
  stars: Int!
  text: String!
  product: Product!
}

type FlaggedRecordResult {
  items: [FlaggedRecordItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

type ModerationObservationItem {
  observation: PriceObservation!
  "Null u anonymního příspěvku nebo po pseudonymizaci (180 dní, docs/soukromi.md)."
  authorPublicUid: ID
  "Vykreslená podoba ('Modrý čáp #4271'), ne kanonický klíč."
  authorHandle: String
  """
  Stav zveřejnění POZOROVANÉHO ZBOŽÍ, ne ceny samotné (docs/reputace.md, "Práh důvěry pro
  zveřejnění nového záznamu") — moderátor tak u DRAFT zboží vidí konkrétní "kolik ze tří"
  potvrzení ještě chybí, místo aby si musel status zjišťovat zvlášť. Publikace zůstává čistě
  peer-to-peer (leave-one-out shoda nezávislých přispěvatelů) — tohle pole je jen čtecí, žádná
  moderátorská mutace ho neumí urychlit ani obejít.
  """
  productPublication: PublicationStatus!
}

type ModerationObservationResult {
  items: [ModerationObservationItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

"Odkud přišel request (core.feedback.client_kind) — odvozeno server-side z X-Client-Kind, nikdy z inputu."
enum ClientKind {
  WEB
  ANDROID
}

"Kategorie zpětné vazby (core.feedback) — jen k roztřídění fronty, nemění chování."
enum FeedbackCategory {
  BUG
  IDEA
  CONTENT
  OTHER
}

input FeedbackInput {
  category: FeedbackCategory!
  message: String!
  "Nepovinný — odpověď je pak možná jen u přihlášeného odesílatele."
  contactEmail: String
  "Route/obrazovka, ze které se odesílalo (jen orientační)."
  pageRef: String
  appVersion: String
  "Volitelně přiložený záznam o posledním pádu appky (mobil) — nikdy neodchází bez akce uživatele."
  diagnostics: String
  "Token z feedbackChallenge, beze změny. Nepovinné jen kvůli starším klientům bez PoW (docs/nasazeni.md)."
  challenge: String
  "Vyřešený nonce k challenge — SHA-256(salt + \":\" + nonce) musí mít difficulty vedoucích nulových bitů."
  nonce: String
  """
  Honeypot proti spamovacím botům — appka pole nikdy nevyplní, jen ho v UI schová (CSS, ne
  hidden atribut, který by bot mohl přeskočit). Nepoužívá se na mobilu, appka ho tam neposílá.
  """
  website: String
}

type FeedbackResult {
  id: ID!
}

"""
Podepsaná proof-of-work výzva (docs/nasazeni.md, obrana proti spamu) — vydává feedbackChallenge,
řešení se posílá zpět ve FeedbackInput.
"""
type FeedbackChallenge {
  "Posílá se zpět beze změny ve FeedbackInput.challenge."
  token: String!
  "Prefix, který klient hashuje spolu s hledaným nonce."
  salt: String!
  "Kolik nejvyšších bitů SHA-256(salt + \":\" + nonce) musí být nula."
  difficulty: Int!
}

"""
Jedno hlášení ve frontě zpětné vazby (jen moderátor) — na rozdíl od FlaggedRecordItem se autor
VRACÍ (authorPublicUid/authorHandle/contactEmail), protože bez něj není komu odpovědět
(docs/soukromi.md, vědomá odchylka od nahlašování). authorPublicUid je null u anonyma.
"""
type FeedbackItem {
  id: ID!
  category: FeedbackCategory!
  message: String!
  contactEmail: String
  clientKind: ClientKind!
  appVersion: String
  platformInfo: String
  locale: String
  country: String
  pageRef: String
  diagnostics: String
  createdAt: DateTime!
  handled: Boolean!
  handledNote: String
  authorPublicUid: ID
  authorHandle: String
  "Součet skóre FeedbackSpamDetector — 0 u přihlášeného odesílatele a u všeho bez signálu."
  spamScore: Int!
  "Kódy signálů, které ke skóre přispěly (např. HONEYPOT, DUPLICATE_MESSAGE) — prázdné, když spamScore je 0."
  spamReasons: [String!]!
  "true = v záložce Podezřelé, ne v běžné frontě. setFeedbackQuarantined je cesta zpět."
  quarantined: Boolean!
}

type FeedbackItemResult {
  items: [FeedbackItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

input CreateStoreInput {
  name: String!
  chainId: ID
  street: String
  city: String!
  postalCode: String
  "Bez zadání server dosadí zemi vieweru, jinak app.i18n.default-country (CountryResolver, docs/lokalizace.md) — ŽÁDNÝ literální default tady, jinak by tahle větev nikdy nenaběhla."
  country: String
  "8 číslic, ověří se v ARES (companyByIco) — viz docs/soukromi.md."
  ico: String
  "Volitelné — bez souřadnic obchod nenajde nearbyStores, jen searchStores."
  lat: Float
  lon: Float
  geoSource: GeoSource
  osmRef: String
  "Odkaz na stránku provozovny (u řetězce) — jako street/city jde přes core.store_user_edit."
  url: String
}

input CreateProductInput {
  name: String!
  "Volný text značky — pokud neexistuje, založí se nová core.brand."
  brandName: String
  categoryId: ID!
  unitBase: UnitBase!
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  piecesInPack: Int
  isVariableWeight: Boolean = false
  "Povinné pro bezkódové zboží; server podle provozovny zvolí rozsah CHAIN nebo STORE."
  storeId: ID
  "Naskenovaný EAN — bez něj vzniká bezkódová druhová položka (isGeneric=true, status=DRAFT)."
  code: String
}

input CreateProductFromOffInput {
  code: String!
  name: String
  brandName: String
  categoryId: ID
  unitBase: UnitBase
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  piecesInPack: Int
  isVariableWeight: Boolean = false
}

enum ProductLookupStatus {
  EXISTING
  OFF_CANDIDATE
  NOT_FOUND
  OFF_UNAVAILABLE
}

type ProductLookupResult {
  status: ProductLookupStatus!
  product: Product
  candidate: ExternalProductCandidate
}

type ExternalProductCandidate {
  code: String!
  name: String
  brandName: String
  category: Category
  unitBase: UnitBase
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  image: ExternalProductImage
  sourceUrl: String!
  attribution: String!
}

type ExternalProductImage {
  url: String!
  thumbnailUrl: String!
  attribution: String!
}

type Brand {
  id: ID!
  name: String!
  slug: String!
}

type Category {
  id: ID!
  name: String!
  slug: String!
  "Hierarchii nese path (řetězec slugů), tohle je jen pořadí SOUROZENCŮ v jedné větvi."
  path: String!
  """
  Kurátorské pořadí mezi sourozenci v jedné větvi stromu (docs/nasazeni.md, kap. 4) — NE
  globální řazení celého číselníku. `Query.categories` vrací plochý seznam řazený podle
  `path` (abecedně podle slugu), takže klient MUSÍ sourozence přeskládat sám podle
  `(sortOrder, name)` při stavbě stromu pro výběr, jinak by např. "Dětské zboží" předběhlo
  "Potraviny".
  """
  sortOrder: Int!
}

enum UnitBase {
  MASS
  VOLUME
  COUNT
}

enum NetContentUom {
  G
  KG
  ML
  L
  PCS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  MERGED
  REJECTED
}

enum ProductScope {
  GLOBAL
  CHAIN
  STORE
  LEGACY_GLOBAL
}

type Product {
  id: ID!
  name: String!
  brand: Brand
  category: Category!
  unitBase: UnitBase!
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  netContentBase: BigDecimal!
  piecesInPack: Int
  isVariableWeight: Boolean!
  status: ProductStatus!
  """
  Druhová položka bez čárového kódu ('Chléb konzumní') — confidence agregátu je pro ni
  zastropovaná na MEDIUM, viz docs/reputace.md, 'Zboží bez čárového kódu'.
  """
  isGeneric: Boolean!
  "Rozsah identity: EAN globálně, bezkódové zboží u řetězce/provozovny."
  catalogScope: ProductScope!
  scopeChain: RetailChain
  scopeStore: Store
  "Aktuální ceny po jednotlivých obchodech (agg.price_current)."
  prices: [PriceCurrent!]!
  codes: [ProductCode!]!
  "Primární GTIN-14 (doplněný nulami zleva) — z něj se skládají externí odkazy."
  gtin: String
  stats: ProductStats!
  quality: ProductQuality!
  "Hvězdičky přihlášeného uživatele, null pro anonyma i pro nehodnocený produkt."
  myQualityRating: Int
  "Počet recenzí S TEXTEM (na rozdíl od quality.count, který počítá i hodnocení bez textu)."
  reviewCount: Int!
  "Vlastní text recenze přihlášeného uživatele, null pro anonyma i bez vlastního textu."
  myReviewText: String
  externalLinks: [ExternalLink!]!
  """
  Konsolidační job zatím neběží (docs/datovy-model.md, "Uživatelská vrstva nad globálními
  daty") — v etapě 1 je vždy false, klient zobrazí štítek "neověřeno".
  """
  verified: Boolean!
  "True, pokud pro tenhle produkt existuje uživatelův patch (core.product_user_edit)."
  editedByMe: Boolean!
  "Globální výchozí vrstva katalogu; osobní product_user_edit ji může překrýt."
  catalogSource: CatalogDataSource!
  "Povinná atribuce, jen když catalogSource=OPEN_FOOD_FACTS."
  catalogAttribution: String
  "Externí OFF obrázek; nikdy nejde o core.media Photo."
  externalImage: ExternalProductImage
  """
  Poslední vlastní zápisy přihlášeného uživatele (na obchod a druh ceny) — zobrazí se jako
  "Vaše cena" vedle komunitního agregátu (prices), i dřív než je zpracuje agregace. Prázdné
  pole pro anonyma i pro produkt bez vlastního zápisu.
  """
  myPrices: [MyPrice!]!
  "Fotky zboží (core.media) — první (nejnižší sortOrder) je hlavní. Prázdné, dokud je nikdo nenahraje."
  photos: [Photo!]!
}

enum CatalogDataSource {
  COMMUNITY
  OPEN_FOOD_FACTS
}

"""
Částka přepočtená do zobrazovací měny kurzem ČNB platným k danému dni (docs/lokalizace.md,
"Kurzovní lístek a zobrazovací měna"). Null vždy, když se přepočet neprovedl — hlavička
X-Display-Currency nedorazila, rovná se původní měně, nebo pro daný den kurz neznáme (appka
pak zobrazí jen původní částku).
"""
type ConvertedPrice {
  amount: BigDecimal!
  currency: String!
  "Datum lístku, kterým se přepočítávalo — ČNB nepublikuje o víkendech a svátcích, může být starší než den ceny."
  rateDate: Date!
}

"Zobrazovací měny a stav kurzovního lístku ČNB. USD je jen referenční — cenu v ní zapsat nejde."
type FxInfo {
  displayCurrencies: [String!]!
  "Nejnovější den, pro který appka kurz má — null, dokud proběhne první stažení."
  latestRateDate: Date
  attribution: String!
}

type MyPrice {
  store: Store!
  priceKind: PriceKind!
  priceAmount: BigDecimal!
  unitPrice: BigDecimal
  observedAt: DateTime!
  currency: String!
  "Přepočet do zobrazovací měny kurzem k observedAt (X-Display-Currency)."
  converted: ConvertedPrice
  "Platnost akce (jen PROMO)."
  promoValidFrom: Date
  "Platnost akce (jen PROMO)."
  promoValidTo: Date
}

"""
Kdy se vlastní záznam propaguje globálně (docs/datovy-model.md, "Uživatelská vrstva nad
globálními daty"; prahy v docs/reputace.md) — jeden zdroj pravdy pro "Moje příspěvky", ať
klient neumí zobrazit protichůdný text na dvou různých obrazovkách.
"""
enum PublicationState {
  "Vidí každý (status ACTIVE)."
  PUBLIC
  "DRAFT zboží / PENDING obchod — v hledání zatím vidí jen autor, dokud ho nepotvrdí jiní přispěvatelé."
  AWAITING_CONFIRMATIONS
  "hidden_at != null po nahlášení (core.record_flag) — čeká na přezkum, vidí ho dál jen autor."
  HIDDEN_AFTER_FLAGS
  "Patch v core.product_user_edit/core.store_user_edit — konsolidační job zatím neběží, vidí ho jen autor."
  PENDING_MERGE
}

type PublicationStatus {
  state: PublicationState!
  "Kolik RŮZNÝCH jiných přispěvatelů už zapsalo cenu (leave-one-out, docs/reputace.md). Null mimo AWAITING_CONFIRMATIONS."
  confirmationsReceived: Int
  "app.catalog.draft-confirmations v době dotazu. Null mimo AWAITING_CONFIRMATIONS."
  confirmationsRequired: Int
  "verified_at != null — konsolidační job záznam uznal za globální (v etapě 1 vždy false)."
  verified: Boolean!
}

type MyProductItem {
  product: Product!
  createdAt: DateTime!
  publication: PublicationStatus!
}

type MyProductResult {
  items: [MyProductItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

type MyStoreItem {
  store: Store!
  createdAt: DateTime!
  publication: PublicationStatus!
}

type MyStoreResult {
  items: [MyStoreItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

type MyObservationItem {
  product: Product!
  store: Store!
  priceKind: PriceKind!
  priceAmount: BigDecimal!
  unitPrice: BigDecimal
  currency: String!
  "Přepočet do zobrazovací měny kurzem k observedAt (X-Display-Currency), stejný princip jako MyPrice.converted."
  converted: ConvertedPrice
  "Platnost akce (jen PROMO)."
  promoValidFrom: Date
  "Platnost akce (jen PROMO)."
  promoValidTo: Date
  observedAt: DateTime!
  createdAt: DateTime!
  """
  Odvozeno z blokujícího katalogového záznamu (zboží NEBO obchod, cokoli z obou brání
  zveřejnění) — samotná cena žádný práh zveřejnění nemá, do agg.price_current ji dostane
  fronta přepočtu do pár sekund (PriceAggregationService).
  """
  publication: PublicationStatus!
}

type MyObservationResult {
  items: [MyObservationItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

type MyEditItem {
  recordType: RecordType!
  "Vyplněno jen pro recordType PRODUCT, jinak null."
  product: Product
  "Vyplněno jen pro recordType STORE, jinak null."
  store: Store
  updatedAt: DateTime!
  "Strojové názvy polí, která patch mění nebo maže (cleared_fields) — popisek je věc klienta."
  changedFields: [String!]!
  "Vždy PENDING_MERGE — úprava cizího záznamu čeká na konsolidační job."
  publication: PublicationStatus!
}

type MyEditResult {
  items: [MyEditItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

type MyReviewItem {
  product: Product!
  stars: Int!
  text: String!
  createdAt: DateTime!
  "Null, pokud text po napsání nebyl upraven, stejný princip jako ProductReview.updatedAt."
  updatedAt: DateTime
  "Skryto moderací (core.record_flag, RecordType.REVIEW) — vidí jen autor, ať ví, že a proč recenze zmizela z produktu."
  hidden: Boolean!
}

type MyReviewResult {
  items: [MyReviewItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

enum CodeType {
  GTIN
  PLU
  STORE_INTERNAL
}

type ProductCode {
  code: String!
  codeType: CodeType!
  "Povinný u STORE_INTERNAL — ten kód NIKDY neplatí napříč řetězci (docs/datovy-model.md)."
  chain: RetailChain
  primary: Boolean!
}

type ProductStats {
  observationCount: Int!
  storeCount: Int!
  lastObservedAt: DateTime
  "Nejnižší běžná (REGULAR) cena napříč obchody a kde."
  bestPrice: BigDecimal
  bestUnitPrice: BigDecimal
  cheapestStore: Store
  "Měna bestPrice/bestUnitPrice — null, jen když je bestPrice null (docs/lokalizace.md)."
  bestPriceCurrency: String
  "Přepočet bestPrice do zobrazovací měny kurzem k lastObservedAt (X-Display-Currency)."
  bestPriceConverted: ConvertedPrice
}

"Průměr hvězdiček 1,00–5,00 (5 nejlepší). Null, dokud nikdo nehodnotil."
type ProductQuality {
  average: BigDecimal
  count: Int!
}

"""
Jedna recenze pod zbožím (core.product_review) — vždy nese hvězdičky, text jen když ho autor
napsal. Autor je tu VŽDY vidět (authorPublicUid/authorName) — na rozdíl od zbytku veřejného API
(docs/soukromi.md, "Podepsaná recenze": jinde se autor objevuje jen v moderátorském pohledu).
"""
type ProductReview {
  id: ID!
  stars: Int!
  text: String!
  "public_uid autora, ne databázové id (docs/soukromi.md) — nikdy nejde hádat podle pořadí."
  authorPublicUid: ID!
  "Vykreslené jméno autora — přezdívka (je-li veřejná), jinak lokalizovaný handle. Vždy s '#číslo'."
  authorName: String!
  createdAt: DateTime!
  "Null, pokud text po napsání nebyl upraven — klient tím rozliší štítek 'upraveno' od updatedAt, které se hýbe i při změně hvězdiček."
  updatedAt: DateTime
  "True pro recenzi přihlášeného viewera — klient tím umí nabídnout Upravit/Smazat místo obecného tlačítka."
  mine: Boolean!
}

type ProductReviewResult {
  items: [ProductReview!]!
  totalCount: Int!
  hasMore: Boolean!
  "Anonym texty nevidí (docs/reputace.md, T1) — true znamená, že items je prázdné bez ohledu na totalCount."
  loginRequired: Boolean!
}

"Vlastní hodnocení včetně textu — návratový typ saveProductReviewText/deleteProductReviewText, ať klient nemusí přenačítat celý produkt."
type MyProductReview {
  stars: Int!
  text: String
  updatedAt: DateTime
}

enum ExternalLinkKind {
  OPEN_FOOD_FACTS
  E_NUMBERS
}

"""
Odkaz do cizí otevřené databáze. Server data z OFF/OSM NIKDY nestahuje do core.* — posílá
jen URL a povinný text zdroje/licence, který UI MUSÍ zobrazit (docs/datovy-model.md, ODbL).
"""
type ExternalLink {
  kind: ExternalLinkKind!
  label: String!
  url: String!
  attribution: String!
}

type ProductSearchResult {
  items: [ProductSearchItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

"""
Řádek seznamu hledání. Agregáty jsou spočítané jedním dotazem spolu s hledáním a respektují
zvolený filtr (obchod/město) — proto nejsou jen polem na Product, kde by filtr nebyl vidět.
"""
type ProductSearchItem {
  product: Product!
  "Počet hlášení celkem (součet agg.price_current.n_obs) v rozsahu filtru."
  observationCount: Int!
  "Nejnižší běžná (REGULAR) cena v rozsahu filtru a obchod, kde je."
  bestPrice: BigDecimal
  bestUnitPrice: BigDecimal
  cheapestStore: Store
  "Počet hlášení právě té nejlevnější buňky — kolik lidí potvrdilo tuhle konkrétní cenu."
  bestPriceObservations: Int
  lastObservedAt: DateTime
  qualityAverage: BigDecimal
  qualityCount: Int!
  "Měna bestPrice/bestUnitPrice — null, jen když je bestPrice null (docs/lokalizace.md)."
  currency: String
  "Přepočet bestPrice do zobrazovací měny kurzem k lastObservedAt (X-Display-Currency)."
  converted: ConvertedPrice
  "Přepočet bestUnitPrice — vlastní kurzový přepočet, ne dopočet z converted/amount."
  convertedUnit: ConvertedPrice
}

type SearchFacets {
  stores: [Store!]!
  cities: [String!]!
}

type PriceHistory {
  priceKind: PriceKind!
  store: Store
  "Skutečně vrácené okno ve dnech — může být kratší než požadované (odstupňování přístupu)."
  days: Int!
  "VŽDY vyplněná (docs/lokalizace.md) — bez storeId je to měna s nejvíc záznamy za dané období."
  currency: String!
  """
  Zobrazovací měna řady (X-Display-Currency), když se liší od currency — null, pokud se
  nepřepočítávalo. Jedna hodnota pro celou řadu, ne ConvertedPrice na bod: rateDate každého
  bodu se liší (viz PricePoint), ale osu grafu appka popisuje jednou.
  """
  displayCurrency: String
  "Atribuce zdroje kurzu (Kurzy ČNB) — appka ji zobrazí vedle grafu, když je displayCurrency vyplněná."
  rateAttribution: String
  points: [PricePoint!]!
}

type PricePoint {
  day: Date!
  priceAmount: BigDecimal
  unitPrice: BigDecimal!
  nObs: Int!
  "Z kolika provozoven medián vznikl (1 při filtru na obchod)."
  storeCount: Int!
  "Přepočet unitPrice kurzem PLATNÝM K TOMUTO DNI (PriceHistory.displayCurrency) — NIKDY dnešním kurzem, jinak by graf mísil pohyb ceny s pohybem kurzu."
  convertedUnitPrice: BigDecimal
  convertedPriceAmount: BigDecimal
}

type Viewer {
  publicHandle: String!
  displayName: String
  createdAt: DateTime!
  "Práh důvěry (docs/reputace.md) — vysvětluje klientovi, proč nový obchod/zboží zatím vidí jen on."
  trusted: Boolean!
  "T4 (docs/reputace.md, 'Odstupňování přístupu') — řídí zobrazení odkazu na /moderation. Nastavuje se ručně na serveru, appka nemá UI na jmenování."
  moderator: Boolean!
  "Uložená preference jazyka (setLocale) — null, dokud si ji uživatel nenastaví (docs/lokalizace.md)."
  locale: String
  "Uložená preference země — null, dokud si ji uživatel nenastaví."
  country: String
  "Jméno, příjmení, telefon, kontaktní e-mail, avatar a viditelnost (docs/soukromi.md, 'Profil uživatele a viditelnost')."
  profile: Profile!
}

"""
Viditelnost profilu (auth.user_profile.visibility) — výchozí ANONYMOUS, aby si lidé ze
setrvačnosti nedávali skutečné jméno (docs/soukromi.md). U PUBLIC/FRIENDS teprve rozhoduje
Profile.visibleFields, KTERÁ pole se komu zobrazí.
"""
enum ProfileVisibility {
  ANONYMOUS
  PUBLIC
  FRIENDS
}

"Pole profilu, pro které lze zvlášť zapnout viditelnost vůči Audience."
enum ProfileField {
  FIRST_NAME
  LAST_NAME
  DISPLAY_NAME
  CONTACT_EMAIL
  PHONE
  AVATAR
}

"Publikum, kterému lze zpřístupnit konkrétní pole profilu."
enum Audience {
  PUBLIC
  FRIENDS
}

type ProfileFieldAudience {
  field: ProfileField!
  audience: Audience!
}

input ProfileFieldAudienceInput {
  field: ProfileField!
  audience: Audience!
}

"""
Profil přihlášeného uživatele — vždy PLNÝ pohled vlastníka (Viewer.profile), nikdy filtrovaný
podle visibility/visibleFields (docs/soukromi.md). Všechna pole jsou nepovinná; jméno/příjmení/
telefon/kontaktní e-mail leží šifrované mimo core/off/osm export, avatar (core.media) šifrovaný
NENÍ.
"""
type Profile {
  firstName: String
  lastName: String
  phone: String
  contactEmail: String
  "Přihlašovací e-mail; mění se VÝHRADNĚ přes REST /api/auth/email/change (OTP na novou adresu) — tady jen ke čtení."
  loginEmail: String!
  visibility: ProfileVisibility!
  visibleFields: [ProfileFieldAudience!]!
  avatar: Photo
}

"""
Patch nad auth.user_profile (+ app_user.display_name) — null u pole znamená "nezměněno",
clearX = true maže hodnotu (stejný vzor jako UpdateStoreInput/UpdateProductInput).
"""
input UpdateProfileInput {
  firstName: String
  clearFirstName: Boolean = false
  lastName: String
  clearLastName: Boolean = false
  displayName: String
  clearDisplayName: Boolean = false
  phone: String
  clearPhone: Boolean = false
  contactEmail: String
  clearContactEmail: Boolean = false
  visibility: ProfileVisibility
  "null nechá matici beze změny, JAKÝKOLI seznam (i prázdný) ji celou nahradí."
  visibleFields: [ProfileFieldAudienceInput!]
}

enum ChainType {
  CHAIN
  INDEPENDENT
  FARM_SHOP
  MARKET
  ONLINE
}

type RetailChain {
  id: ID!
  name: String!
  chainType: ChainType!
}

enum GeoSource {
  "Souřadnice zadal/potvrdil uživatel (ručně, nebo výběrem geokódovaného kandidáta)."
  COMMUNITY
  "Souřadnice převzaté z OpenStreetMap Nominatim — jen lat/lon a osm_ref, nic dalšího z OSM."
  OSM
}

type Store {
  id: ID!
  chain: RetailChain
  name: String!
  street: String
  city: String!
  postalCode: String
  country: String!
  "Nullable — provozovna zadaná bez GPS (zápis doma) může souřadnice dosud nemít."
  lat: Float
  lon: Float
  geoSource: GeoSource!
  "Volitelný identifikátor provozovatele (podniková prodejna, OSVČ) — 8 číslic, viz docs/soukromi.md."
  ico: String
  "Odkaz na stránku provozovny (u řetězce) — volitelný."
  url: String
  "Konsolidační job zatím neběží — v etapě 1 vždy false, klient zobrazí štítek 'neověřeno'."
  verified: Boolean!
  "True, pokud pro tuhle provozovnu existuje uživatelův patch (core.store_user_edit)."
  editedByMe: Boolean!
  """
  Provozovna od nedůvěryhodného autora čeká na potvrzení dalších přispěvatelů
  (docs/reputace.md) — vidí ji jen autor. Klient tím umí vysvětlit, proč zatím nikdo jiný
  obchod nevidí.
  """
  pendingConfirmation: Boolean!
  "Fotky provozovny (core.media) — první (nejnižší sortOrder) je hlavní."
  photos: [Photo!]!
}

type StoreSearchResult {
  items: [Store!]!
  totalCount: Int!
  hasMore: Boolean!
}

"""
Kandidát ze serveru OpenStreetMap Nominatim — nic z tohohle se neukládá do core.* kromě
lat/lon a osmRef zvoleného kandidáta (docs/datovy-model.md, oddělení ODbL dat).
"""
type GeocodeCandidate {
  lat: Float!
  lon: Float!
  displayName: String!
  "Formát '{typ}/{id}' (např. 'way/123456') — ukládá se do core.store.osm_ref při výběru."
  osmRef: String!
}

type GeocodeResult {
  candidates: [GeocodeCandidate!]!
  "Povinný text zdroje/licence (ODbL) — UI ho musí zobrazit vedle výsledků."
  attribution: String!
}

"""
Adresa dohledaná ze souřadnic (reverseGeocode) — všechna pole nullable, neúplná adresa nebo
výpadek Nominatimu se projeví jako prázdná pole, ne jako chyba dotazu.
"""
type ReverseGeocodeResult {
  street: String
  city: String
  postalCode: String
  country: String
  "Formát '{typ}/{id}' — ukládá se do core.store.osm_ref, pokud uživatel výsledek potvrdí."
  osmRef: String
  "Povinný text zdroje/licence (ODbL) — UI ho musí zobrazit."
  attribution: String!
}

"Údaje o firmě z veřejného rejstříku ARES — ne ODbL data, jen předvyplnění formuláře."
type CompanyInfo {
  ico: String!
  name: String!
  street: String
  city: String
  postalCode: String
}

"""
Číselník zemí, které appka zná (app.i18n.country-currency/country-locale) — jeden zdroj pravdy
pro formulář obchodu a přepínač země v Nastavení, místo aby si CZ/SK/PL hardcodoval každý
klient zvlášť (docs/lokalizace.md, "Country selector v UI").
"""
type CountryInfo {
  code: String!
  "Měna, ve které se v této zemi zapisují ceny (CurrencyResolver.forStore)."
  currency: String!
  "Výchozí jazyk appky pro tuhle zemi (app.i18n.country-locale) — jen předvyplnění, jazyk zůstává nezávislou volbou klienta."
  defaultLocale: String
  "Název země lokalizovaný podle jazyka aktuálního requestu (messages/countries*.properties)."
  name: String!
}

enum PriceKind {
  REGULAR
  PROMO
  CLUB_CARD
  CLEARANCE
  MULTIBUY
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

type PriceCurrent {
  store: Store!
  priceKind: PriceKind!
  unitPrice: BigDecimal
  priceAmount: BigDecimal
  nObs: Int!
  "Kishova efektivní velikost vzorku — viz docs/reputace.md."
  nEff: BigDecimal!
  lastObservedAt: DateTime
  confidence: Confidence!
  currency: String!
  "Přepočet unitPrice do zobrazovací měny kurzem k lastObservedAt (X-Display-Currency)."
  converted: ConvertedPrice
  """
  MAX(promoValidTo) napříč observacemi buňky (jen PROMO, jinak null). Vypršelou akci
  Product.prices vůbec nevrátí (ProductGraphQlController filtruje při čtení,
  docs/datovy-model.md) — je-li tahle buňka vidět a pole je vyplněné, akce ještě platí.
  """
  promoValidTo: Date
}

enum QuantityBasis {
  PACKAGE
  PER_KG
  PER_L
  PER_PIECE
}

enum ObservationStatus {
  ACTIVE
  PENDING
  DISPUTED
  REJECTED
}

type PriceObservation {
  id: ID!
  product: Product!
  store: Store!
  priceAmount: BigDecimal!
  currency: String!
  priceKind: PriceKind!
  quantityBasis: QuantityBasis!
  unitPrice: BigDecimal
  "Platnost akce (jen PROMO) — kdy uživatel viděl, že akce začala platit."
  promoValidFrom: Date
  "Platnost akce (jen PROMO) — do kdy akce platí."
  promoValidTo: Date
  observedAt: DateTime!
  status: ObservationStatus!
}

"""
Hlavička dávky: co, kde a kdy. Tyhle údaje jsou z podstaty společné všem cenám z jednoho
regálu — kdyby byly per řádek, šlo by poslat REGULAR v CZK a CLUB_CARD v EUR pro tutéž
cenovku (docs/lokalizace.md, "Multi-měna") nebo dva různé produkty v jedné "dávce", u které
by pak nedávalo smysl, co se má přepočítat (jedna položka agg.recompute_queue).
"""
input SubmitObservationsInput {
  productId: ID!
  storeId: ID!
  quantityBasis: QuantityBasis = PACKAGE
  "Kdy uživatel cenu viděl — chybí-li, použije se teď (docs/datovy-model.md, observed_at ≠ created_at)."
  observedAt: DateTime
  """
  ISO-4217 kód měny — chybí-li, dosadí se podle země obchodu (docs/lokalizace.md). Volitelný
  jen kvůli příhraničním prodejnám, které občas cení v jiné měně, než je země provozovny;
  server hodnotu validuje proti podporovaným měnám, neplatnou tiše ignoruje a dosadí zemi obchodu.
  """
  currency: String
  """
  1–5 cen z jednoho regálu. Druh ceny se v seznamu NESMÍ opakovat (nejvýš jedna cena každého
  druhu na uživatele/produkt/obchod/den) — duplicita shodí celou dávku
  s OBSERVATION_DUPLICATE_PRICE_KIND.
  """
  prices: [ObservationPriceInput!]!
}

"Jeden řádek formuláře: druh ceny + částka. MULTIBUY má místo priceAmount dvojici qty/total."
input ObservationPriceInput {
  priceKind: PriceKind! = REGULAR
  "Povinná pro všechny druhy kromě MULTIBUY, kde se cena odvodí z multibuyTotal."
  priceAmount: BigDecimal
  "Povinné pro MULTIBUY (např. „3 za 50“)."
  multibuyQty: Int
  multibuyTotal: BigDecimal
  """
  Platnost akce — smí se vyplnit jen u PROMO (jinak OBSERVATION_PROMO_VALIDITY_NOT_ALLOWED).
  Obě pole nepovinná. Nesmí být v budoucnu — zapisuje se cena, kterou uživatel VIDĚL v regále,
  ne cena z letáku, která ještě nezačala platit (jinak OBSERVATION_PROMO_VALID_FROM_IN_FUTURE).
  """
  promoValidFrom: Date
  "Platnost akce — do kdy platí. Musí být >= promoValidFrom, jinak OBSERVATION_PROMO_VALIDITY_RANGE_INVALID."
  promoValidTo: Date
}

"""
Strojově čitelný kód chyby (docs/lokalizace.md) — jde jen do GraphQL extensions.code, NIKDY
do žádného pole typu. Existuje ve schématu čistě proto, aby ho graphql-codegen vygeneroval
jako TS konstanty (frontend/codegen.ts, onlyEnums) — frontend nad ním postaví Record<ErrorCode,
string>, stejný trik jako PRICE_KIND_LABELS, takže chybějící překlad kódu shodí kompilaci.
Musí se shodovat s cz.kvalitacena.exception.ErrorCode (viz backendový test MessageBundleTest).
"""
enum ErrorCode {
  PRODUCT_NOT_FOUND
  STORE_NOT_FOUND
  CATEGORY_NOT_FOUND
  CHAIN_NOT_FOUND
  PRODUCT_NAME_REQUIRED
  PRODUCT_NAME_EMPTY
  PRODUCT_CATEGORY_REQUIRED
  PRODUCT_UNIT_BASE_REQUIRED
  OFF_PRODUCT_NOT_FOUND
  OFF_UNAVAILABLE
  STORE_NAME_REQUIRED
  STORE_NAME_EMPTY
  STORE_CITY_REQUIRED
  STORE_CITY_EMPTY
  STORE_URL_INVALID
  COMPANY_ID_INVALID
  UNSUPPORTED_COUNTRY
  STORE_COUNTRY_EDIT_REQUIRES_TRUST
  PRODUCT_CREATE_REQUIRES_LOGIN
  PRODUCT_EDIT_REQUIRES_LOGIN
  STORE_CREATE_REQUIRES_LOGIN
  STORE_EDIT_REQUIRES_LOGIN
  DUPLICATE_PRODUCT_CODE
  DUPLICATE_GENERIC_PRODUCT
  DUPLICATE_STORE
  PHOTO_UPLOAD_REQUIRES_LOGIN
  PHOTO_ACTION_REQUIRES_LOGIN
  PHOTO_CANNOT_ATTACH_TO_PHOTO
  PHOTO_CANNOT_ATTACH_TO_USER
  PHOTO_LIMIT_REACHED
  PHOTO_DELETE_NOT_OWNER
  PHOTO_UPDATE_NOT_OWNER
  PHOTO_NOT_FOUND
  PHOTO_TARGET_RECORD_NOT_FOUND
  PHOTO_TOO_LARGE
  PHOTO_UNSUPPORTED_FORMAT
  PHOTO_UNREADABLE
  PHOTO_RESOLUTION_TOO_HIGH
  OBSERVATION_ALREADY_SUBMITTED_TODAY
  OBSERVATION_PRICES_REQUIRED
  OBSERVATION_DUPLICATE_PRICE_KIND
  OBSERVATION_PRICE_KIND_ALREADY_SUBMITTED_TODAY
  OBSERVATION_PRICE_INCOMPLETE
  OBSERVATION_PROMO_VALIDITY_NOT_ALLOWED
  OBSERVATION_PROMO_VALIDITY_RANGE_INVALID
  OBSERVATION_PROMO_VALID_FROM_IN_FUTURE
  QUALITY_REQUIRES_LOGIN
  QUALITY_STARS_OUT_OF_RANGE
  REVIEW_REQUIRES_LOGIN
  REVIEW_REQUIRES_RATING
  REVIEW_TEXT_EMPTY
  REVIEW_TEXT_TOO_LONG
  FLAG_REQUIRES_LOGIN
  FLAG_RECORD_NOT_FOUND
  MODERATION_REQUIRES_ROLE
  MODERATION_RECORD_NOT_FOUND
  MODERATION_OBSERVATION_NOT_FOUND
  MODERATION_USER_NOT_FOUND
  FEEDBACK_MESSAGE_REQUIRED
  FEEDBACK_MESSAGE_TOO_LONG
  FEEDBACK_CONTACT_EMAIL_INVALID
  FEEDBACK_NOT_FOUND
  FEEDBACK_CHALLENGE_REQUIRED
  FEEDBACK_CHALLENGE_INVALID
  INVALID_CHALLENGE
  SESSION_EXPIRED
  TERMS_ACCEPTANCE_REQUIRED
  ACCOUNT_SUSPENDED
  LOCALE_REQUIRES_LOGIN
  LOCALE_UNSUPPORTED
  PROFILE_REQUIRES_LOGIN
  PROFILE_NAME_TOO_LONG
  PROFILE_DISPLAY_NAME_TOO_LONG
  PROFILE_PHONE_INVALID
  PROFILE_EMAIL_INVALID
  AVATAR_REQUIRES_LOGIN
  EMAIL_CHANGE_REQUIRES_LOGIN
  EMAIL_CHANGE_SAME_ADDRESS
  EMAIL_CHANGE_INVALID_CHALLENGE
  EMAIL_CHANGE_EMAIL_TAKEN
  ACCOUNT_DELETE_REQUIRES_LOGIN
  ACCOUNT_DELETE_INVALID_CHALLENGE
  CONTRIBUTIONS_REQUIRE_LOGIN
  ACCOUNT_GONE
  TOO_MANY_REQUESTS
  UOM_MISMATCH
  VALIDATION_FAILED
  CLIENT_VERSION_TOO_OLD
}
