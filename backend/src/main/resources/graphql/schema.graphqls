"""
Etapa 1 (MVP) — hledání zboží s filtry a řazením, ceny po obchodech, hodnocení kvality
(jen známka 1–5, bez textů), denní historie ceny pro graf, dohledání nejbližších provozoven
a zápis ceny. Textové recenze, skupiny důvěry, notifikace a dodavatelé přijdou v etapě 2/3
(viz plán založení projektu).
"""
scalar Long
scalar BigDecimal
scalar DateTime
scalar Date

enum ProductSort {
  "Výchozí — nejvíc potvrzené zboží nahoře (součet agg.price_current.n_obs)."
  REPORT_COUNT
  PRICE_ASC
  "1 = nejlepší, tedy vzestupně."
  QUALITY
  LAST_REPORTED
  NAME
}

type Query {
  """
  Fulltextové hledání podle názvu (core.product, idx_product_name_fts) s volitelným filtrem
  na obchod nebo město a řazením. storeId/city omezují i agregáty v ProductSearchItem — s
  filtrem na město ukazuje seznam cenu a počet hlášení jen za dané město, ne celostátně.

  country omezuje na provozovny v jedné zemi/měně (docs/lokalizace.md) — bez toho by
  ProductSort.PRICE_ASC řadilo CZK vedle PLN v jednom sloupci a "nejlevnější obchod" by
  porovnával nesrovnatelné částky. Bez zadání se použije země přihlášeného uživatele, jinak
  app.i18n.default-country — NIKDY neomezené celosvětové hledání.
  """
  searchProducts(
    query: String!
    storeId: ID
    city: String
    country: String
    sort: ProductSort = REPORT_COUNT
    first: Int = 20
    offset: Int = 0
  ): ProductSearchResult!

  "Číselník pro filtry hledání — jen obchody a města, kde nějaká cena skutečně je. country viz searchProducts."
  searchFacets(query: String, country: String): SearchFacets!

  """
  Našeptávač obchodů podle názvu/města (core.norm_text, pg_trgm) — doplněk k nearbyStores pro
  zápis ceny bez sdílení polohy nebo zpětně z domova (docs/datovy-model.md, "Identita
  provozovny"). Na rozdíl od nearbyStores najde i obchody bez souřadnic.
  """
  searchStores(query: String, city: String, first: Int = 20, offset: Int = 0): StoreSearchResult!

  """
  Detail jedné provozovny (stránka obchodu — adresa, mapa, fotky). Stejná viditelnost pod
  prahem důvěry jako product(id): ACTIVE vidí každý, vlastní PENDING (docs/reputace.md) jen
  autor. Null, když provozovna neexistuje nebo není vidět.
  """
  store(id: ID!): Store

  """
  Podobné zboží podle názvu (pg_trgm) — druhové položky (Product.isGeneric) i zboží s kódem.
  Slouží k nabídnutí existující druhové položky při bezkódovém zápisu i jako povinná kontrola
  duplicit před založením nového zboží (docs/reputace.md, "Zboží bez čárového kódu").
  """
  productSuggestions(name: String!, first: Int = 10): [Product!]!

  "Plochý seznam kategorií pro zakládání zboží — hierarchii nese Category.path."
  categories: [Category!]!

  """
  Souřadnice k zadané adrese přes OpenStreetMap Nominatim. Dotaz jde VŽDY ze serveru, nikdy
  z klienta (docs/soukromi.md — jinak by šla přímo IP uživatele) a odpověď se necachuje do
  core.*/osm.* — ukládá se jen zvolený bod jako core.store.lat/lon + osmRef s geoSource=OSM.
  UI MUSÍ zobrazit attribution. Výpadek Nominatimu vrací prázdný seznam kandidátů, nikdy chybu
  — založení obchodu bez souřadnic musí projít i tak.

  country bez zadání NEZNAMENÁ "celý svět" — server dosadí zemi přihlášeného uživatele, jinak
  app.i18n.default-country (docs/lokalizace.md), nikdy neomezené celosvětové hledání.
  """
  geocodeAddress(street: String, city: String!, postalCode: String, country: String): GeocodeResult!

  """
  Opačný směr než geocodeAddress — souřadnice na adresu, pro tlačítko "Použít mou polohu" při
  editaci obchodu. Stejná pravidla soukromí platí ještě přísněji: parametrem je tady rovnou
  poloha UŽIVATELE, ne adresa obchodu, takže dotaz jde výhradně ze serveru
  (docs/soukromi.md) a souřadnice se nikam nezapisují. Výpadek Nominatimu vrací prázdná pole,
  nikdy chybu.
  """
  reverseGeocode(lat: Float!, lon: Float!): ReverseGeocodeResult!

  """
  Údaje o firmě z veřejného rejstříku podle IČO/NIP — předvyplnění formuláře obchodu (zatím jen
  ARES pro CZ, docs/lokalizace.md). Není ODbL data (je to veřejný rejstřík, ne OSM/OFF), takže
  se nemusí držet stranou core.*. Vrací null, když IČO/NIP neexistuje, je registr nedostupný,
  nebo appka pro danou zemi žádný registr nezná (klient pak schová tlačítko "Načíst z registru").
  """
  companyByIco(ico: String!, country: String): CompanyInfo

  product(id: ID!): Product

  """
  Dohledání produktu podle naskenovaného čárového kódu (EAN). Backend kód normalizuje na
  GTIN-14 (docs/datovy-model.md) — mobil posílá kód přesně tak, jak ho přečetl skener.
  """
  productByCode(code: String!): Product

  """
  Provozovny v okolí zadaného bodu. Souřadnice se používají JEN jako parametry dotazu
  a nikam se neukládají — viz docs/soukromi.md.
  """
  nearbyStores(lat: Float!, lon: Float!, radiusKm: Float = 3): [Store!]!

  """
  Denní řada z agg.price_daily. Graf NIKDY nečte core.price_observation
  (docs/datovy-model.md). Bez storeId je to medián mediánů přes provozovny
  (docs/reputace.md), se storeId jedna provozovna.

  currency omezí (nebo přepíše) měnu grafu — bez zadání se národní graf ukáže v měně
  s nejvíc záznamy za dané období (docs/lokalizace.md).
  """
  priceHistory(productId: ID!, priceKind: PriceKind = REGULAR, storeId: ID, days: Int = 90, currency: String): PriceHistory!

  "Veřejná identita přihlášeného uživatele — bez e-mailu a bez DB id (docs/soukromi.md)."
  me: Viewer

  """
  Zobrazovací měny a stav kurzovního lístku ČNB (docs/lokalizace.md, "Kurzovní lístek a
  zobrazovací měna"). USD je jen referenční — cenu v ní zapsat nejde (SubmitObservationInput
  ji nepřijímá), je to výhradně přepočet pro zobrazení napříč zeměmi.
  """
  fxInfo: FxInfo!
}

type Mutation {
  "Zápis cenového záznamu — funguje i anonymně (nižší váha, viz docs/reputace.md)."
  submitObservation(input: SubmitObservationInput!): PriceObservation!

  """
  Známka kvality jako ve škole: 1 nejlepší … 5 nejhorší. Jeden záznam na uživatele a produkt
  — opakované volání předchozí známku přepíše. Vyžaduje přihlášení.
  """
  rateProduct(productId: ID!, grade: Int!): ProductQuality!

  """
  Založení provozovny — pro zápis ceny bez sdílení polohy nebo zpětně z domova. Vyžaduje
  přihlášení (docs/reputace.md, T1) a rovnou zakládá ACTIVE záznam; klient si před voláním
  MUSÍ ověřit searchStores(name, city) a nabídnout uživateli případné shody (uq_store_identity
  je až poslední pojistka, ne jediná obrana proti duplicitám).
  """
  createStore(input: CreateStoreInput!): Store!

  """
  Založení zboží — s naskenovaným kódem i bez něj (bezkódová druhová položka, docs/reputace.md,
  "Zboží bez čárového kódu"). Vyžaduje přihlášení. Bez kódu vzniká jako status DRAFT a
  isGeneric=true; klient by měl nejdřív zkusit productSuggestions(name), ať nezaloží duplikát
  existující druhové položky.
  """
  createProduct(input: CreateProductInput!): Product!

  """
  Úprava existujícího zboží jako patch nad core.product_user_edit — globální řádek se nemění,
  úpravu vidí jen autor (docs/datovy-model.md, "Uživatelská vrstva nad globálními daty").
  Vyžaduje přihlášení. Pole s hodnotou null v inputu zůstává nezměněné.
  """
  updateProduct(id: ID!, input: UpdateProductInput!): Product!

  """
  Úprava existující provozovny jako patch nad core.store_user_edit — stejný princip jako
  updateProduct. Vyžaduje přihlášení.
  """
  updateStore(id: ID!, input: UpdateStoreInput!): Store!

  """
  Nahlášení zboží/obchodu jako podezřelého nebo nesmyslného — hlasuje se o FAKTU, nikdy o
  ČLOVĚKU (docs/reputace.md, "Nesouhlas se vyjadřuje k faktu, ne k člověku"). Po dosažení
  app.moderation.flags-to-hide různých nahlášení se záznam skryje a čeká na přezkum. Vyžaduje
  přihlášení; opakované nahlášení stejným člověkem nic nemění.
  """
  flagRecord(recordType: RecordType!, recordId: ID!, reason: String): FlagResult!

  """
  Popisek a pořadí fotky (nejnižší sortOrder = hlavní fotka záznamu). Jen autor fotky, jinak
  UnauthorizedException.
  """
  updatePhoto(id: ID!, caption: String, sortOrder: Int): Photo!

  "Smazání vlastní fotky (core.media i soubor v MediaStorage). Jen autor."
  deletePhoto(id: ID!): Boolean!

  """
  Uloží preferovaný jazyk a zemi přihlášeného uživatele — používá se VÝHRADNĚ pro asynchronní
  výstup (OTP e-mail, později notifikace). Synchronní odpovědi tohoto API se vždy řídí hlavičkou
  Accept-Language, ne touhle hodnotou (docs/lokalizace.md). Volba jazyka je autoritativně na
  klientovi, tahle mutace ji jen posílá na server. Vyžaduje přihlášení.
  """
  setLocale(locale: String!, country: String): Viewer!

  """
  Úprava profilu (jméno, příjmení, přezdívka, telefon, kontaktní e-mail, viditelnost) —
  docs/soukromi.md, "Profil uživatele a viditelnost". Vyžaduje přihlášení. Avatar se nahrává
  přes REST POST /api/media/user/avatar (multipart, stejný důvod jako u ostatních fotek),
  tahle mutace ho jen umí smazat (deleteAvatar).
  """
  updateProfile(input: UpdateProfileInput!): Viewer!

  "Smazání avatara profilu. Vyžaduje přihlášení."
  deleteAvatar: Viewer!
}

enum RecordType {
  PRODUCT
  STORE
  "Nahlašovaný typ pro flagRecord — core.media samo nese jen PRODUCT/STORE (čí je fotka)."
  PHOTO
}

"""
Fotka zboží nebo provozovny (core.media) — nahrává se přes REST POST /api/media/{recordType}/
{recordId}, protože multipart upload GraphQL v tomhle projektu nepodporuje (viz backend
MediaController). url/thumbnailUrl vedou na stejný REST endpoint (GET).
"""
type Photo {
  id: ID!
  url: String!
  thumbnailUrl: String!
  width: Int!
  height: Int!
  caption: String
  "Nahrál ji přihlášený uživatel — smí ji smazat a upravit popisek."
  mine: Boolean!
  "Skrytá po nahlášení (RecordType.PHOTO); vidí ji dál už jen autor (docs/reputace.md)."
  hidden: Boolean!
  "Povinný text licence, klient ho MUSÍ zobrazit u galerie."
  attribution: String!
}

input UpdateProductInput {
  name: String
  brandName: String
  "True smaže značku (vrátí zboží na 'bez značky') — jinak se posílá brandName."
  clearBrand: Boolean = false
  categoryId: ID
  unitBase: UnitBase
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  piecesInPack: Int
  clearPiecesInPack: Boolean = false
  isVariableWeight: Boolean
}

input UpdateStoreInput {
  name: String
  chainId: ID
  clearChain: Boolean = false
  street: String
  clearStreet: Boolean = false
  city: String
  postalCode: String
  clearPostalCode: Boolean = false
  country: String
  "8 číslic, ověří se kontrolním součtem — viz docs/soukromi.md."
  ico: String
  clearIco: Boolean = false
  lat: Float
  lon: Float
  geoSource: GeoSource
  osmRef: String
}

type FlagResult {
  "Kolik různých lidí záznam zatím nahlásilo."
  flagCount: Int!
  "True, pokud nahlášení právě teď (nebo už dřív) záznam skrylo."
  hidden: Boolean!
}

input CreateStoreInput {
  name: String!
  chainId: ID
  street: String
  city: String!
  postalCode: String
  country: String = "CZ"
  "8 číslic, ověří se v ARES (companyByIco) — viz docs/soukromi.md."
  ico: String
  "Volitelné — bez souřadnic obchod nenajde nearbyStores, jen searchStores."
  lat: Float
  lon: Float
  geoSource: GeoSource
  osmRef: String
}

input CreateProductInput {
  name: String!
  "Volný text značky — pokud neexistuje, založí se nová core.brand."
  brandName: String
  categoryId: ID!
  unitBase: UnitBase!
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  piecesInPack: Int
  isVariableWeight: Boolean = false
  "Naskenovaný EAN — bez něj vzniká bezkódová druhová položka (isGeneric=true, status=DRAFT)."
  code: String
}

type Brand {
  id: ID!
  name: String!
  slug: String!
}

type Category {
  id: ID!
  name: String!
  slug: String!
  path: String!
}

enum UnitBase {
  MASS
  VOLUME
  COUNT
}

enum NetContentUom {
  G
  KG
  ML
  L
  PCS
}

enum ProductStatus {
  DRAFT
  ACTIVE
  MERGED
  REJECTED
}

type Product {
  id: ID!
  name: String!
  brand: Brand
  category: Category!
  unitBase: UnitBase!
  netContentValue: BigDecimal
  netContentUom: NetContentUom
  netContentBase: BigDecimal!
  piecesInPack: Int
  isVariableWeight: Boolean!
  status: ProductStatus!
  """
  Druhová položka bez čárového kódu ('Chléb konzumní') — confidence agregátu je pro ni
  zastropovaná na MEDIUM, viz docs/reputace.md, 'Zboží bez čárového kódu'.
  """
  isGeneric: Boolean!
  "Aktuální ceny po jednotlivých obchodech (agg.price_current)."
  prices: [PriceCurrent!]!
  codes: [ProductCode!]!
  "Primární GTIN-14 (doplněný nulami zleva) — z něj se skládají externí odkazy."
  gtin: String
  stats: ProductStats!
  quality: ProductQuality!
  "Známka přihlášeného uživatele, null pro anonyma i pro nehodnocený produkt."
  myQualityRating: Int
  externalLinks: [ExternalLink!]!
  """
  Konsolidační job zatím neběží (docs/datovy-model.md, "Uživatelská vrstva nad globálními
  daty") — v etapě 1 je vždy false, klient zobrazí štítek "neověřeno".
  """
  verified: Boolean!
  "True, pokud pro tenhle produkt existuje uživatelův patch (core.product_user_edit)."
  editedByMe: Boolean!
  """
  Poslední vlastní zápisy přihlášeného uživatele (na obchod a druh ceny) — zobrazí se jako
  "Vaše cena" vedle komunitního agregátu (prices), i dřív než je zpracuje agregace. Prázdné
  pole pro anonyma i pro produkt bez vlastního zápisu.
  """
  myPrices: [MyPrice!]!
  "Fotky zboží (core.media) — první (nejnižší sortOrder) je hlavní. Prázdné, dokud je nikdo nenahraje."
  photos: [Photo!]!
}

"""
Částka přepočtená do zobrazovací měny kurzem ČNB platným k danému dni (docs/lokalizace.md,
"Kurzovní lístek a zobrazovací měna"). Null vždy, když se přepočet neprovedl — hlavička
X-Display-Currency nedorazila, rovná se původní měně, nebo pro daný den kurz neznáme (appka
pak zobrazí jen původní částku).
"""
type ConvertedPrice {
  amount: BigDecimal!
  currency: String!
  "Datum lístku, kterým se přepočítávalo — ČNB nepublikuje o víkendech a svátcích, může být starší než den ceny."
  rateDate: Date!
}

"Zobrazovací měny a stav kurzovního lístku ČNB. USD je jen referenční — cenu v ní zapsat nejde."
type FxInfo {
  displayCurrencies: [String!]!
  "Nejnovější den, pro který appka kurz má — null, dokud proběhne první stažení."
  latestRateDate: Date
  attribution: String!
}

type MyPrice {
  store: Store!
  priceKind: PriceKind!
  priceAmount: BigDecimal!
  unitPrice: BigDecimal
  observedAt: DateTime!
  currency: String!
  "Přepočet do zobrazovací měny kurzem k observedAt (X-Display-Currency)."
  converted: ConvertedPrice
}

enum CodeType {
  GTIN
  PLU
  STORE_INTERNAL
}

type ProductCode {
  code: String!
  codeType: CodeType!
  "Povinný u STORE_INTERNAL — ten kód NIKDY neplatí napříč řetězci (docs/datovy-model.md)."
  chain: RetailChain
  primary: Boolean!
}

type ProductStats {
  observationCount: Int!
  storeCount: Int!
  lastObservedAt: DateTime
  "Nejnižší běžná (REGULAR) cena napříč obchody a kde."
  bestPrice: BigDecimal
  bestUnitPrice: BigDecimal
  cheapestStore: Store
  "Měna bestPrice/bestUnitPrice — null, jen když je bestPrice null (docs/lokalizace.md)."
  bestPriceCurrency: String
  "Přepočet bestPrice do zobrazovací měny kurzem k lastObservedAt (X-Display-Currency)."
  bestPriceConverted: ConvertedPrice
}

"Průměrná známka 1,00–5,00 (1 nejlepší). Null, dokud nikdo nehodnotil."
type ProductQuality {
  average: BigDecimal
  count: Int!
}

enum ExternalLinkKind {
  OPEN_FOOD_FACTS
  E_NUMBERS
}

"""
Odkaz do cizí otevřené databáze. Server data z OFF/OSM NIKDY nestahuje do core.* — posílá
jen URL a povinný text zdroje/licence, který UI MUSÍ zobrazit (docs/datovy-model.md, ODbL).
"""
type ExternalLink {
  kind: ExternalLinkKind!
  label: String!
  url: String!
  attribution: String!
}

type ProductSearchResult {
  items: [ProductSearchItem!]!
  totalCount: Int!
  hasMore: Boolean!
}

"""
Řádek seznamu hledání. Agregáty jsou spočítané jedním dotazem spolu s hledáním a respektují
zvolený filtr (obchod/město) — proto nejsou jen polem na Product, kde by filtr nebyl vidět.
"""
type ProductSearchItem {
  product: Product!
  "Počet hlášení celkem (součet agg.price_current.n_obs) v rozsahu filtru."
  observationCount: Int!
  "Nejnižší běžná (REGULAR) cena v rozsahu filtru a obchod, kde je."
  bestPrice: BigDecimal
  bestUnitPrice: BigDecimal
  cheapestStore: Store
  "Počet hlášení právě té nejlevnější buňky — kolik lidí potvrdilo tuhle konkrétní cenu."
  bestPriceObservations: Int
  lastObservedAt: DateTime
  qualityAverage: BigDecimal
  qualityCount: Int!
  "Měna bestPrice/bestUnitPrice — null, jen když je bestPrice null (docs/lokalizace.md)."
  currency: String
  "Přepočet bestPrice do zobrazovací měny kurzem k lastObservedAt (X-Display-Currency)."
  converted: ConvertedPrice
  "Přepočet bestUnitPrice — vlastní kurzový přepočet, ne dopočet z converted/amount."
  convertedUnit: ConvertedPrice
}

type SearchFacets {
  stores: [Store!]!
  cities: [String!]!
}

type PriceHistory {
  priceKind: PriceKind!
  store: Store
  "Skutečně vrácené okno ve dnech — může být kratší než požadované (odstupňování přístupu)."
  days: Int!
  "VŽDY vyplněná (docs/lokalizace.md) — bez storeId je to měna s nejvíc záznamy za dané období."
  currency: String!
  """
  Zobrazovací měna řady (X-Display-Currency), když se liší od currency — null, pokud se
  nepřepočítávalo. Jedna hodnota pro celou řadu, ne ConvertedPrice na bod: rateDate každého
  bodu se liší (viz PricePoint), ale osu grafu appka popisuje jednou.
  """
  displayCurrency: String
  "Atribuce zdroje kurzu (Kurzy ČNB) — appka ji zobrazí vedle grafu, když je displayCurrency vyplněná."
  rateAttribution: String
  points: [PricePoint!]!
}

type PricePoint {
  day: Date!
  priceAmount: BigDecimal
  unitPrice: BigDecimal!
  nObs: Int!
  "Z kolika provozoven medián vznikl (1 při filtru na obchod)."
  storeCount: Int!
  "Přepočet unitPrice kurzem PLATNÝM K TOMUTO DNI (PriceHistory.displayCurrency) — NIKDY dnešním kurzem, jinak by graf mísil pohyb ceny s pohybem kurzu."
  convertedUnitPrice: BigDecimal
  convertedPriceAmount: BigDecimal
}

type Viewer {
  publicHandle: String!
  displayName: String
  createdAt: DateTime!
  "Práh důvěry (docs/reputace.md) — vysvětluje klientovi, proč nový obchod/zboží zatím vidí jen on."
  trusted: Boolean!
  "Uložená preference jazyka (setLocale) — null, dokud si ji uživatel nenastaví (docs/lokalizace.md)."
  locale: String
  "Uložená preference země — null, dokud si ji uživatel nenastaví."
  country: String
  "Jméno, příjmení, telefon, kontaktní e-mail, avatar a viditelnost (docs/soukromi.md, 'Profil uživatele a viditelnost')."
  profile: Profile!
}

"""
Viditelnost profilu (auth.user_profile.visibility) — výchozí ANONYMOUS, aby si lidé ze
setrvačnosti nedávali skutečné jméno (docs/soukromi.md). U PUBLIC/FRIENDS teprve rozhoduje
Profile.visibleFields, KTERÁ pole se komu zobrazí.
"""
enum ProfileVisibility {
  ANONYMOUS
  PUBLIC
  FRIENDS
}

"Pole profilu, pro které lze zvlášť zapnout viditelnost vůči Audience."
enum ProfileField {
  FIRST_NAME
  LAST_NAME
  DISPLAY_NAME
  CONTACT_EMAIL
  PHONE
  AVATAR
}

"Publikum, kterému lze zpřístupnit konkrétní pole profilu."
enum Audience {
  PUBLIC
  FRIENDS
}

type ProfileFieldAudience {
  field: ProfileField!
  audience: Audience!
}

input ProfileFieldAudienceInput {
  field: ProfileField!
  audience: Audience!
}

"""
Profil přihlášeného uživatele — vždy PLNÝ pohled vlastníka (Viewer.profile), nikdy filtrovaný
podle visibility/visibleFields (docs/soukromi.md). Všechna pole jsou nepovinná; jméno/příjmení/
telefon/kontaktní e-mail leží šifrované mimo core/off/osm export, avatar (core.media) šifrovaný
NENÍ.
"""
type Profile {
  firstName: String
  lastName: String
  phone: String
  contactEmail: String
  "Přihlašovací e-mail; mění se VÝHRADNĚ přes REST /api/auth/email/change (OTP na novou adresu) — tady jen ke čtení."
  loginEmail: String!
  visibility: ProfileVisibility!
  visibleFields: [ProfileFieldAudience!]!
  avatar: Photo
}

"""
Patch nad auth.user_profile (+ app_user.display_name) — null u pole znamená "nezměněno",
clearX = true maže hodnotu (stejný vzor jako UpdateStoreInput/UpdateProductInput).
"""
input UpdateProfileInput {
  firstName: String
  clearFirstName: Boolean = false
  lastName: String
  clearLastName: Boolean = false
  displayName: String
  clearDisplayName: Boolean = false
  phone: String
  clearPhone: Boolean = false
  contactEmail: String
  clearContactEmail: Boolean = false
  visibility: ProfileVisibility
  "null nechá matici beze změny, JAKÝKOLI seznam (i prázdný) ji celou nahradí."
  visibleFields: [ProfileFieldAudienceInput!]
}

enum ChainType {
  CHAIN
  INDEPENDENT
  FARM_SHOP
  MARKET
  ONLINE
}

type RetailChain {
  id: ID!
  name: String!
  chainType: ChainType!
}

enum GeoSource {
  "Souřadnice zadal/potvrdil uživatel (ručně, nebo výběrem geokódovaného kandidáta)."
  COMMUNITY
  "Souřadnice převzaté z OpenStreetMap Nominatim — jen lat/lon a osm_ref, nic dalšího z OSM."
  OSM
}

type Store {
  id: ID!
  chain: RetailChain
  name: String!
  street: String
  city: String!
  postalCode: String
  country: String!
  "Nullable — provozovna zadaná bez GPS (zápis doma) může souřadnice dosud nemít."
  lat: Float
  lon: Float
  geoSource: GeoSource!
  "Volitelný identifikátor provozovatele (podniková prodejna, OSVČ) — 8 číslic, viz docs/soukromi.md."
  ico: String
  "Konsolidační job zatím neběží — v etapě 1 vždy false, klient zobrazí štítek 'neověřeno'."
  verified: Boolean!
  "True, pokud pro tuhle provozovnu existuje uživatelův patch (core.store_user_edit)."
  editedByMe: Boolean!
  """
  Provozovna od nedůvěryhodného autora čeká na potvrzení dalších přispěvatelů
  (docs/reputace.md) — vidí ji jen autor. Klient tím umí vysvětlit, proč zatím nikdo jiný
  obchod nevidí.
  """
  pendingConfirmation: Boolean!
  "Fotky provozovny (core.media) — první (nejnižší sortOrder) je hlavní."
  photos: [Photo!]!
}

type StoreSearchResult {
  items: [Store!]!
  totalCount: Int!
  hasMore: Boolean!
}

"""
Kandidát ze serveru OpenStreetMap Nominatim — nic z tohohle se neukládá do core.* kromě
lat/lon a osmRef zvoleného kandidáta (docs/datovy-model.md, oddělení ODbL dat).
"""
type GeocodeCandidate {
  lat: Float!
  lon: Float!
  displayName: String!
  "Formát '{typ}/{id}' (např. 'way/123456') — ukládá se do core.store.osm_ref při výběru."
  osmRef: String!
}

type GeocodeResult {
  candidates: [GeocodeCandidate!]!
  "Povinný text zdroje/licence (ODbL) — UI ho musí zobrazit vedle výsledků."
  attribution: String!
}

"""
Adresa dohledaná ze souřadnic (reverseGeocode) — všechna pole nullable, neúplná adresa nebo
výpadek Nominatimu se projeví jako prázdná pole, ne jako chyba dotazu.
"""
type ReverseGeocodeResult {
  street: String
  city: String
  postalCode: String
  country: String
  "Formát '{typ}/{id}' — ukládá se do core.store.osm_ref, pokud uživatel výsledek potvrdí."
  osmRef: String
  "Povinný text zdroje/licence (ODbL) — UI ho musí zobrazit."
  attribution: String!
}

"Údaje o firmě z veřejného rejstříku ARES — ne ODbL data, jen předvyplnění formuláře."
type CompanyInfo {
  ico: String!
  name: String!
  street: String
  city: String
  postalCode: String
}

enum PriceKind {
  REGULAR
  PROMO
  CLUB_CARD
  CLEARANCE
  MULTIBUY
}

enum Confidence {
  LOW
  MEDIUM
  HIGH
}

type PriceCurrent {
  store: Store!
  priceKind: PriceKind!
  unitPrice: BigDecimal
  priceAmount: BigDecimal
  nObs: Int!
  "Kishova efektivní velikost vzorku — viz docs/reputace.md."
  nEff: BigDecimal!
  lastObservedAt: DateTime
  confidence: Confidence!
  currency: String!
  "Přepočet unitPrice do zobrazovací měny kurzem k lastObservedAt (X-Display-Currency)."
  converted: ConvertedPrice
}

enum QuantityBasis {
  PACKAGE
  PER_KG
  PER_L
  PER_PIECE
}

enum ObservationStatus {
  ACTIVE
  PENDING
  DISPUTED
  REJECTED
}

type PriceObservation {
  id: ID!
  product: Product!
  store: Store!
  priceAmount: BigDecimal!
  currency: String!
  priceKind: PriceKind!
  quantityBasis: QuantityBasis!
  unitPrice: BigDecimal
  observedAt: DateTime!
  status: ObservationStatus!
}

input SubmitObservationInput {
  productId: ID!
  storeId: ID!
  priceAmount: BigDecimal!
  priceKind: PriceKind = REGULAR
  quantityBasis: QuantityBasis = PACKAGE
  "Povinné jen pro MULTIBUY (např. '3 za 50')."
  multibuyQty: Int
  multibuyTotal: BigDecimal
  "Kdy uživatel cenu viděl — chybí-li, použije se teď (docs/datovy-model.md, observed_at ≠ created_at)."
  observedAt: DateTime
  """
  ISO-4217 kód měny — chybí-li, dosadí se podle země obchodu (docs/lokalizace.md). Volitelný
  jen kvůli příhraničním prodejnám, které občas cení v jiné měně, než je země provozovny;
  server hodnotu validuje proti podporovaným měnám, neplatnou tiše ignoruje a dosadí zemi obchodu.
  """
  currency: String
}

"""
Strojově čitelný kód chyby (docs/lokalizace.md) — jde jen do GraphQL extensions.code, NIKDY
do žádného pole typu. Existuje ve schématu čistě proto, aby ho graphql-codegen vygeneroval
jako TS konstanty (frontend/codegen.ts, onlyEnums) — frontend nad ním postaví Record<ErrorCode,
string>, stejný trik jako PRICE_KIND_LABELS, takže chybějící překlad kódu shodí kompilaci.
Musí se shodovat s cz.kvalitacena.exception.ErrorCode (viz backendový test MessageBundleTest).
"""
enum ErrorCode {
  PRODUCT_NOT_FOUND
  STORE_NOT_FOUND
  CATEGORY_NOT_FOUND
  CHAIN_NOT_FOUND
  PRODUCT_NAME_REQUIRED
  PRODUCT_NAME_EMPTY
  PRODUCT_CATEGORY_REQUIRED
  PRODUCT_UNIT_BASE_REQUIRED
  STORE_NAME_REQUIRED
  STORE_NAME_EMPTY
  STORE_CITY_REQUIRED
  STORE_CITY_EMPTY
  COMPANY_ID_INVALID
  PRODUCT_CREATE_REQUIRES_LOGIN
  PRODUCT_EDIT_REQUIRES_LOGIN
  STORE_CREATE_REQUIRES_LOGIN
  STORE_EDIT_REQUIRES_LOGIN
  DUPLICATE_PRODUCT_CODE
  DUPLICATE_GENERIC_PRODUCT
  DUPLICATE_STORE
  PHOTO_UPLOAD_REQUIRES_LOGIN
  PHOTO_ACTION_REQUIRES_LOGIN
  PHOTO_CANNOT_ATTACH_TO_PHOTO
  PHOTO_CANNOT_ATTACH_TO_USER
  PHOTO_LIMIT_REACHED
  PHOTO_DELETE_NOT_OWNER
  PHOTO_UPDATE_NOT_OWNER
  PHOTO_NOT_FOUND
  PHOTO_TARGET_RECORD_NOT_FOUND
  PHOTO_TOO_LARGE
  PHOTO_UNSUPPORTED_FORMAT
  PHOTO_UNREADABLE
  PHOTO_RESOLUTION_TOO_HIGH
  QUALITY_REQUIRES_LOGIN
  QUALITY_GRADE_OUT_OF_RANGE
  FLAG_REQUIRES_LOGIN
  FLAG_RECORD_NOT_FOUND
  INVALID_CHALLENGE
  SESSION_EXPIRED
  TERMS_ACCEPTANCE_REQUIRED
  LOCALE_REQUIRES_LOGIN
  LOCALE_UNSUPPORTED
  PROFILE_REQUIRES_LOGIN
  PROFILE_NAME_TOO_LONG
  PROFILE_DISPLAY_NAME_TOO_LONG
  PROFILE_PHONE_INVALID
  PROFILE_EMAIL_INVALID
  AVATAR_REQUIRES_LOGIN
  EMAIL_CHANGE_REQUIRES_LOGIN
  EMAIL_CHANGE_SAME_ADDRESS
  EMAIL_CHANGE_INVALID_CHALLENGE
  EMAIL_CHANGE_EMAIL_TAKEN
  ACCOUNT_DELETE_REQUIRES_LOGIN
  ACCOUNT_DELETE_INVALID_CHALLENGE
  ACCOUNT_GONE
  TOO_MANY_REQUESTS
  UOM_MISMATCH
  VALIDATION_FAILED
  CLIENT_VERSION_TOO_OLD
}
