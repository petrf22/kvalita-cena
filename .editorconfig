# Konfigurace editoru, viz https://editorconfig.org
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.ts]
quote_type = single
ij_typescript_use_double_quotes = false

# Kotlin kód drží 2 mezery jako zbytek monorepa (všech 119 souborů v mobile/ je tak psaných).
# Čtyři mezery mají jen Gradle skripty, kde odpovídají konvenci Gradle.
[*.kt]
indent_size = 2

[*.kts]
indent_size = 4

[*.md]
max_line_length = off
trim_trailing_whitespace = false
