# Šablona pro `.env` vedle compose.prod.yaml (docs/vydani.md, "Neexistuje produkční backend").
# Zkopíruj na `.env` a doplň skutečné hodnoty — `.env` samotný je v .gitignore, nikdy se
# necommituje. Hodnoty tady jsou jen ukázka tvaru, ne funkční tajemství.

# --- PostgreSQL ---
POSTGRES_USER=kvalitacena
POSTGRES_PASSWORD=

# --- Appka (backend/src/main/resources/application-prod.yml) ---
# Bez těchto tří appka záměrně nenastartuje (žádný dev fallback v produkčním profilu).
# JWT_SECRET / EMAIL_HASH_PEPPER / EMAIL_ENC_KEY vygeneruj nezávisle, např.:
#   openssl rand -base64 32
# EMAIL_HASH_PEPPER změna po prvním uživateli = nikdo se nepřihlásí (docs/soukromi.md) — musí
# být finální PŘED prvním reálným účtem.
JWT_SECRET=
EMAIL_HASH_PEPPER=
EMAIL_ENC_KEY=

# --- SMTP pro OTP e-maily (backend/src/main/java/.../service/SmtpOtpMailSender.java) ---
# Rozhodnuto (docs/nasazeni.md, sekce 3): Gigaserver, přes schránku kontakt@kvalitacena.cz.
# Příklad:
#   SMTP_HOST=mail.gigaserver.cz
#   SMTP_USERNAME=kontakt@kvalitacena.cz
#   SMTP_PASSWORD=<heslo schránky, mimo repo>
# SMTP_PORT musí zůstat 587 (STARTTLS) — jednak je to jediný port, který tahle konfigurace
# (starttls.enable: true bez ssl.enable v application-prod.yml) umí, jednak je to jediný odchozí
# SMTP port, který Hetzner na cloud serverech neblokuje (25 a 465 blokované, docs/nasazeni.md).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Odesílací adresa — u poskytovatele s ověřenou doménou musí patřit k ní, jinak SMTP zprávu
# rovnou odmítne. Tvar: "KvalitaACena <kontakt@kvalitacena.cz>".
SMTP_FROM=

# --- Nominatim (OpenStreetMap geokódování) ---
# Usage policy vyžaduje identifikovatelný kontakt, jinak riziko zablokování IP serveru
# (https://operations.osmfoundation.org/policies/nominatim/). Tvar: "KvalitaACena/0.1 (email)".
NOMINATIM_USER_AGENT=

# --- Web (frontend/Caddyfile) ---
SITE_ADDRESS=https://kvalitacena.cz
# Vlastní site blok pro mobilní klienty (mobile/app/build.gradle.kts, release BASE_URL) —
# bez něj Caddy pro tenhle hostname nezíská TLS certifikát a release APK nemá kam mluvit.
API_ADDRESS=https://api.kvalitacena.cz
# Nepovinné — redirect na kanonickou adresu bez "www.", jen pokud existuje DNS záznam na
# www.kvalitacena.cz (docs/nasazeni.md). Bez proměnné se blok neaktivuje.
# WWW_ADDRESS=https://www.kvalitacena.cz
# Nepovinné — Let's Encrypt upozorní na tuhle adresu při problému s obnovou certifikátu.
# ACME_EMAIL=kontakt@kvalitacena.cz
# Nepovinné — přepnout na staging autoritu při prvním ladění DNS/Caddyfile na produkci, ať se
# nepálí ostrý rate limit Let's Encrypt (docs/nasazeni.md):
# ACME_CA=https://acme-staging-v02.api.letsencrypt.org/directory

# --- Aktivní profily appky (compose.prod.yaml) ---
# "prod,beta" jen během uzavřené bety (docs/nasazeni.md, backend/.../application-beta.yml) —
# dočasně snižuje prahy důvěry, ať appka nepůsobí prázdně s hrstkou pozvaných lidí. Před
# veřejným spuštěním (Fáze 3) vrátit zpátky na jen "prod".
SPRING_PROFILES_ACTIVE=prod

# --- Nouzový bootstrap bez funkčního SMTP (docs/nasazeni.md) ---
# `application-prod.yml` má `app.auth.otp.mail-enabled: true` napevno — appka bez fungujícího
# SMTP nepustí dovnitř NIKOHO, včetně tebe (OtpService.requestOtp je @Transactional a odeslání
# e-mailu je uvnitř transakce, selhání shodí celý požadavek). Proměnná prostředí má přednost
# před application-prod.yml, takže odkomentováním se dá přihlásit i bez SMTP: kód se místo
# e-mailu vypíše do logu backendu ("docker compose -f compose.prod.yaml logs backend"),
# ConsoleOtpMailSender ho neposílá klientovi, takže to není bezpečnostní díra — je to ale díra
# do UX, takže PŘED pozváním DALŠÍCH lidí zpátky zakomentovat/smazat.
# APP_AUTH_OTP_MAIL_ENABLED=false

# --- Minimální verze mobilního klienta (ClientVersionFilter, docs/vydani.md) ---
# 0 = kontrola vypnutá (výchozí, application.yml). Nastav až při breaking změně GraphQL
# schématu mezi vydáními — appka pak starý klient zablokuje srozumitelnou obrazovkou místo
# nesrozumitelné chyby z každého volání. Hodnota je mobilní `versionCode`
# (mobile/app/build.gradle.kts), ne `versionName`.
# APP_CLIENT_MIN_ANDROID_VERSION=0
