# Šablona pro `.env` vedle compose.prod.yaml (docs/vydani.md, "Neexistuje produkční backend").
# Zkopíruj na `.env` a doplň skutečné hodnoty — `.env` samotný je v .gitignore, nikdy se
# necommituje. Hodnoty tady jsou jen ukázka tvaru, ne funkční tajemství.

# --- PostgreSQL ---
POSTGRES_USER=kvalitacena
POSTGRES_PASSWORD=

# --- Appka (backend/src/main/resources/application-prod.yml) ---
# Bez těchto tří appka záměrně nenastartuje (žádný dev fallback v produkčním profilu).
# JWT_SECRET / EMAIL_HASH_PEPPER / EMAIL_ENC_KEY vygeneruj nezávisle, např.:
#   openssl rand -base64 32
# EMAIL_HASH_PEPPER změna po prvním uživateli = nikdo se nepřihlásí (docs/soukromi.md) — musí
# být finální PŘED prvním reálným účtem.
JWT_SECRET=
EMAIL_HASH_PEPPER=
EMAIL_ENC_KEY=

# --- SMTP pro OTP e-maily (backend/src/main/java/.../service/SmtpOtpMailSender.java) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Odesílací adresa — u poskytovatele s ověřenou doménou musí patřit k ní, jinak SMTP zprávu
# rovnou odmítne. Tvar: "KvalitaACena <kontakt@kvalitacena.cz>".
SMTP_FROM=

# --- Nominatim (OpenStreetMap geokódování) ---
# Usage policy vyžaduje identifikovatelný kontakt, jinak riziko zablokování IP serveru
# (https://operations.osmfoundation.org/policies/nominatim/). Tvar: "KvalitaACena/0.1 (email)".
NOMINATIM_USER_AGENT=

# --- Web (frontend/Caddyfile) ---
SITE_ADDRESS=https://kvalitacena.cz
# Vlastní site blok pro mobilní klienty (mobile/app/build.gradle.kts, release BASE_URL) —
# bez něj Caddy pro tenhle hostname nezíská TLS certifikát a release APK nemá kam mluvit.
API_ADDRESS=https://api.kvalitacena.cz

# --- Aktivní profily appky (compose.prod.yaml) ---
# "prod,beta" jen během uzavřené bety (docs/nasazeni.md, backend/.../application-beta.yml) —
# dočasně snižuje prahy důvěry, ať appka nepůsobí prázdně s hrstkou pozvaných lidí. Před
# veřejným spuštěním (Fáze 3) vrátit zpátky na jen "prod".
SPRING_PROFILES_ACTIVE=prod
